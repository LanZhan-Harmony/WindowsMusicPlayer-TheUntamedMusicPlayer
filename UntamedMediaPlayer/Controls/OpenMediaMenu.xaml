<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.OpenMediaMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
             xmlns:ctrl="using:UntamedMediaPlayer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:UntamedMediaPlayer.Helpers"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <SplitButton x:Uid="OpenMediaSplitButton">
        <SplitButton.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyout.Items>
                    <ctrl:MenuFlyoutItemWithSecondaryText KeyTipPlacementMode="Left">
                        <i:Interaction.Behaviors>
                            <behaviors:LiveAccessKeyBehavior AccessVirtualKey="F"/>
                        </i:Interaction.Behaviors>
                        <ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                            <FontIcon/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                        <ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                            <KeyboardAccelerator/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                    </ctrl:MenuFlyoutItemWithSecondaryText>
                    <ctrl:MenuFlyoutItemWithSecondaryText KeyTipPlacementMode="Left">
                        <i:Interaction.Behaviors>
                            <behaviors:LiveAccessKeyBehavior AccessVirtualKey="O"/>
                        </i:Interaction.Behaviors>
                        <ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                            <FontIcon/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                        <ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                            <KeyboardAccelerator/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                    </ctrl:MenuFlyoutItemWithSecondaryText>
                    <ctrl:MenuFlyoutItemWithSecondaryText KeyTipPlacementMode="Left">
                        <i:Interaction.Behaviors>
                            <behaviors:LiveAccessKeyBehavior AccessVirtualKey="U"/>
                        </i:Interaction.Behaviors>
                        <ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                            <FontIcon/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.Icon>
                        <ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                            <KeyboardAccelerator/>
                        </ctrl:MenuFlyoutItemWithSecondaryText.KeyboardAccelerators>
                    </ctrl:MenuFlyoutItemWithSecondaryText>
                </MenuFlyout.Items>
            </MenuFlyout>
        </SplitButton.Flyout>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState/>
                <VisualState>
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OpenMediaSplitButtonName.Width" Value="0"/>
                        <Setter Target="OpenMediaSplitButtonName.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Orientation="Horizontal">
            <FontIcon FontSize="{StaticResource IconFontSize}"/>
            <TextBlock x:Name="OpenMediaSplitButtonName"
                       Margin="{StaticResource ElementLeftMargin}"
                       AutomationProperties.AccessibilityView="Raw"
                       Style="{StaticResource BodyNoMargin}"
                       TextWrapping="NoWrap"/>
        </StackPanel>
    </SplitButton>
</UserControl>
