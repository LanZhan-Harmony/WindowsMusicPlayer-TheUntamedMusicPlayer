<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.EmptyPageMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:UntamedMediaPlayer.Helpers"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="NarrowEmptyPageScrollViewer"
                   BasedOn="{StaticResource ContentContainerScrollViewer}"
                   TargetType="ScrollViewer">
                <Setter Property="Padding" Value="4,0"/>
            </Style>
            <Style x:Key="NarrowEmptyPagePanel"
                   BasedOn="{StaticResource EmptyPagePanel}"
                   TargetType="StackPanel">
                <Setter Property="Margin" Value="16,0,0,0"/>
            </Style>
            <Style x:Key="NarrowEmptyHomePageScrollViewer"
                   BasedOn="{StaticResource ContentContainerScrollViewer}"
                   TargetType="ScrollViewer">
                <Setter Property="Padding" Value="4,0,8,0"/>
            </Style>
            <Style x:Key="NarrowEmptyHomePagePanel"
                   BasedOn="{StaticResource EmptyPagePanel}"
                   TargetType="StackPanel">
                <Setter Property="Margin" Value="12,0,0,0"/>
            </Style>
            <x:Double x:Key="HomeEmptyPageImageSize">280</x:Double>
            <x:Double x:Key="HomeEmptyPageImageNarrowSize">168</x:Double>
            <Style x:Key="EmptyPageTitle"
                   BasedOn="{StaticResource Title}"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="LineHeight" Value="36"/>
            </Style>
            <Style x:Key="EmptyPageSubTitle"
                   BasedOn="{StaticResource SubTitle}"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>
            <Style x:Key="EmptyPageScrollViewer"
                   BasedOn="{StaticResource ContentContainerScrollViewer}"
                   TargetType="ScrollViewer">
                <Setter Property="Padding" Value="40,0"/>
            </Style>
            <Style x:Key="EmptyPagePanel" TargetType="StackPanel">
                <Setter Property="Margin" Value="32,0,0,0"/>
                <Setter Property="MaxWidth" Value="416"/>
            </Style>
            <x:Double x:Key="EmptyPageImageSize">150</x:Double>
            <x:Double x:Key="EmptyPageImageNarrowSize">90</x:Double>
            <Style x:Key="EmptyHomePageScrollViewer"
                   BasedOn="{StaticResource ContentContainerScrollViewer}"
                   TargetType="ScrollViewer">
                <Setter Property="Padding" Value="38,0"/>
            </Style>
            <Style x:Key="EmptyHomePagePanel"
                   BasedOn="{StaticResource EmptyPagePanel}"
                   TargetType="StackPanel">
                <Setter Property="Margin" Value="24,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="content" Style="{StaticResource EmptyPageScrollViewer}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveLayout">
                <VisualState x:Name="DefaultPage"/>
                <VisualState x:Name="DefaultPageAndNarrow">
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="content.Style" Value="{StaticResource NarrowEmptyPageScrollViewer}"/>
                        <Setter Target="image.Width" Value="{StaticResource EmptyPageImageNarrowSize}"/>
                        <Setter Target="image.Height" Value="{StaticResource EmptyPageImageNarrowSize}"/>
                        <Setter Target="panel.Style" Value="{StaticResource NarrowEmptyPagePanel}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HomePageAndNarrow">
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="content.Style" Value="{StaticResource NarrowEmptyHomePageScrollViewer}"/>
                        <Setter Target="image.Width" Value="{StaticResource HomeEmptyPageImageNarrowSize}"/>
                        <Setter Target="image.Height" Value="{StaticResource HomeEmptyPageImageNarrowSize}"/>
                        <Setter Target="panel.Style" Value="{StaticResource NarrowEmptyHomePagePanel}"/>
                        <Setter Target="button.Visibility" Value="Collapsed"/>
                        <Setter Target="openMediaMenu.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HomePage">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="content.Style" Value="{StaticResource EmptyHomePageScrollViewer}"/>
                        <Setter Target="image.Width" Value="{StaticResource HomeEmptyPageImageSize}"/>
                        <Setter Target="image.Height" Value="{StaticResource HomeEmptyPageImageSize}"/>
                        <Setter Target="panel.Style" Value="{StaticResource EmptyHomePagePanel}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PageStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="HomePageState">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="button.Visibility" Value="Collapsed"/>
                        <Setter Target="openMediaMenu.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="image"
                   Width="{StaticResource EmptyPageImageSize}"
                   Height="{StaticResource EmptyPageImageSize}"
                   AutomationProperties.AccessibilityView="Raw"/>
            <StackPanel x:Name="panel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource EmptyPagePanel}">
                <TextBlock Style="{StaticResource EmptyPageTitle}"/>
                <TextBlock Style="{StaticResource EmptyPageSubTitle}"/>
                <Button x:Name="button"
                        HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}">
                    <i:Interaction.Behaviors>
                        <behaviors:LiveAccessKeyBehavior/>
                    </i:Interaction.Behaviors>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="{StaticResource ElementRightMargin}"
                                  VerticalAlignment="Center"
                                  FontSize="{StaticResource IconFontSize}"/>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyNoMargin}"/>
                    </StackPanel>
                </Button>
                <local:OpenMediaMenu x:Name="openMediaMenu"
                                     HorizontalAlignment="Left"
                                     Visibility="Collapsed">
                    <local:OpenMediaMenu.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="AccentButtonForeground"/>
                                    <StaticResource x:Key="SplitButtonForegroundSecondary" ResourceKey="AccentButtonForeground"/>
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPressed" ResourceKey="AccentButtonForegroundPressed"/>
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="AccentButtonForegroundPressed"/>
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver"/>
                                    <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled"/>
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentButtonBorderBrush"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentButtonBorderBrushPressed"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentButtonBorderBrushPointerOver"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="AccentButtonBorderBrushDisabled"/>
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentButtonBackground"/>
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed"/>
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver"/>
                                    <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="AccentButtonForeground"/>
                                    <StaticResource x:Key="SplitButtonForegroundSecondary" ResourceKey="AccentButtonForeground"/>
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPressed" ResourceKey="AccentButtonForegroundPressed"/>
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="AccentButtonForegroundPressed"/>
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver"/>
                                    <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled"/>
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentButtonBorderBrush"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentButtonBorderBrushPressed"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentButtonBorderBrushPointerOver"/>
                                    <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="AccentButtonBorderBrushDisabled"/>
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentButtonBackground"/>
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed"/>
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver"/>
                                    <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast"/>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </local:OpenMediaMenu.Resources>
                </local:OpenMediaMenu>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>