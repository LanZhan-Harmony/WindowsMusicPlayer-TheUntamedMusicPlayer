<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.EqualizerBandControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="../Styles/SliderWithoutFillColorResources.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <local:EqualizerBandSliderControl Grid.Row="0"
                                          Height="{StaticResource EqualizerSliderHeight}"
                                          Margin="{StaticResource ElementSideMargin}"
                                          HorizontalAlignment="Center"
                                          Maximum="12"
                                          Minimum="-12"
                                          Orientation="Vertical"
                                          StepFrequency="0.1"
                                          Style="{StaticResource DefaultSliderStyle}"
                                          TickFrequency="6"
                                          TickPlacement="Outside">
            <local:EqualizerBandSliderControl.ThumbToolTipValueConverter>
                <local:GainValueConverter/>
            </local:EqualizerBandSliderControl.ThumbToolTipValueConverter>
        </local:EqualizerBandSliderControl>
        <TextBlock Grid.Row="1"
                   Margin="{StaticResource ElementTopMargin}"
                   HorizontalAlignment="Center"
                   FontSize="12"/>
    </Grid>
</UserControl>
