                            <Button x:Name="mtcMediaInformationButton"
                                    MinWidth="160"
                                    Padding="{StaticResource ElementSmallSideMargin}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    KeyTipPlacementMode="Top"
                                    Style="{StaticResource DefaultButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Margin="0"/>
                                            <StackPanel>
                                                <TextBlock Margin="{StaticResource ElementTopMargin}" Opacity="{StaticResource SubtleTextOpacity}"/>
                                                <TextBlock Margin="{StaticResource SmallTextTopSpacing}" Opacity="{StaticResource SubtleTextOpacity}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <i:Interaction.Behaviors>
                                    <behaviors:LiveAccessKeyBehavior AccessVirtualKey="Z"/>
                                </i:Interaction.Behaviors>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="{StaticResource openNowPlayingAcceleratorKey}" Modifiers="{StaticResource acceleratorModifierKey}"/>
                                </Button.KeyboardAccelerators>
                                <animations:Implicit.ShowAnimations>
                                    <animations:TranslationAnimation From="0,20,0"
                                                                     To="0"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    <animations:OpacityAnimation From="0"
                                                                 To="1"
                                                                 Duration="{StaticResource ShortAnimationDuration}"/>
                                </animations:Implicit.ShowAnimations>
                                <animations:Implicit.HideAnimations>
                                    <animations:TranslationAnimation From="0"
                                                                     To="0,20,0"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    <animations:OpacityAnimation From="1"
                                                                 To="0"
                                                                 Duration="{StaticResource ShortAnimationDuration}"/>
                                </animations:Implicit.HideAnimations>
                                <ctrl:MediaItemInformation x:Name="mtcMediaInformation" AutomationProperties.AccessibilityView="Raw"/>
                            </Button>
