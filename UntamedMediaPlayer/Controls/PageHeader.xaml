<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:CommunityToolkit.WinUI.Animations"
             xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
             xmlns:ctrl="using:UntamedMediaPlayer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EllipsisButton"
               BasedOn="{StaticResource EllipsisButton}"
               TargetType="Button">
            <Setter Property="Margin" Value="{StaticResource ContentLeftSpacing}"/>
        </Style>
    </UserControl.Resources>
    <CommandBar VerticalContentAlignment="Center"
                DefaultLabelPosition="Right"
                KeyTipPlacementMode="Top">
        <CommandBar.Content>
            <Button x:Name="playAllButton" Style="{StaticResource AccentButtonStyle}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Margin="{StaticResource ElementRightMargin}"
                                      VerticalAlignment="Center"
                                      FontSize="{StaticResource IconFontSize}"
                                      Style="{StaticResource MediaFontIcon}"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyNoMargin}"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </CommandBar.Content>
        <CommandBar.PrimaryCommands>
            <ctrl:SortAndFilterControl x:Name="sortControl"
                                       x:Uid="SortControl"
                                       Margin="{StaticResource ContentLeftSpacing}"
                                       x:Load="False">
                <i:Interaction.Behaviors>
                    <behaviors:MenuFlyoutSelectableItemsDynamicLoadBehavior Converter="{StaticResource SortAndFilterConverter}"/>
                </i:Interaction.Behaviors>
            </ctrl:SortAndFilterControl>
            <ctrl:SortAndFilterControl x:Name="genreControl"
                                       x:Uid="GenreFilterControl"
                                       Margin="{StaticResource ContentLeftSpacing}"
                                       x:Load="False">
                <i:Interaction.Behaviors>
                    <behaviors:MenuFlyoutSelectableItemsDynamicLoadBehavior Converter="{StaticResource SortAndFilterConverter}"/>
                </i:Interaction.Behaviors>
            </ctrl:SortAndFilterControl>
        </CommandBar.PrimaryCommands>
        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation From="0"
                                         To="1"
                                         Duration="{StaticResource ShortAnimationDuration}"/>
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:OpacityAnimation From="1"
                                         To="0"
                                         Duration="{StaticResource ShortAnimationDuration}"/>
        </animations:Implicit.HideAnimations>
    </CommandBar>
</UserControl>
