<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.AddFolderButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:UntamedMediaPlayer.Helpers"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Button x:Name="button" x:Uid="AddFolderButton">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="icon.Margin" Value="0"/>
                        <Setter Target="textLabel.Width" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Orientation="Horizontal">
            <FontIcon x:Name="icon"
                      Margin="{StaticResource ElementRightMargin}"
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource MediaPlayerIconsFontFamily}"
                      FontSize="{StaticResource BigIconFontSize}"
                      Glyph="{StaticResource AddFolderGlyph}"/>
            <TextBlock x:Name="textLabel"
                       x:Uid="AddFolderButtonTextLabel"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyNoMargin}"
                       TextWrapping="NoWrap"/>
        </StackPanel>
    </Button>
</UserControl>