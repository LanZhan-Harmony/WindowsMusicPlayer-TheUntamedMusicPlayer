<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.DetailsPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:UntamedMediaPlayer.Helpers"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <x:Double x:Key="PageHeaderSelectionCommandBarMinHeight">50</x:Double>
        <Style x:Key="HeaderTitle"
               BasedOn="{StaticResource TitleNoWrap}"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Margin" Value="{StaticResource TextBottomSpacing}"/>
        </Style>
        <Style x:Key="HeaderSubTitle"
               BasedOn="{StaticResource DefaultMedataControlStyle}"
               TargetType="local:MetadataControl">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="{StaticResource TextBottomLargeSpacing}"/>
        </Style>
        <x:Double x:Key="CoverArtHeaderNormalSize">162</x:Double>
        <x:Double x:Key="CoverArtHeaderNarrowSize">136</x:Double>
        <x:Double x:Key="CoverArtHeaderLargeSize">208</x:Double>
        <Style x:Key="CompactHeaderTitle"
               BasedOn="{StaticResource HeaderTitle}"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style x:Key="CompactHeaderSubTitle"
               BasedOn="{StaticResource DefaultMedataControlStyle}"
               TargetType="local:MetadataControl">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="{StaticResource ContentSmallBottomSpacing}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SystemControlTransparentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="LargeDefault">
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Large,ExtraLarge"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Normal">
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Normal"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="textScaleFactor.Width" Value="{StaticResource CoverArtHeaderNormalSize}"/>
                        <Setter Target="textScaleFactor.Height" Value="{StaticResource CoverArtHeaderNormalSize}"/>
                        <Setter Target="title.Style" Value="{StaticResource CompactHeaderTitle}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="textScaleFactor.Width" Value="{StaticResource CoverArtHeaderNarrowSize}"/>
                        <Setter Target="textScaleFactor.Height" Value="{StaticResource CoverArtHeaderNarrowSize}"/>
                        <Setter Target="title.Style" Value="{StaticResource CompactHeaderTitle}"/>
                        <Setter Target="subtitle.Style" Value="{StaticResource CompactHeaderSubTitle}"/>
                        <Setter Target="topHeader.Padding" Value="{StaticResource ContentMargin}"/>
                        <Setter Target="additionalInformation.Margin" Value="{StaticResource TextBottomLargeSpacing}"/>
                        <Setter Target="pageHeaderBarContainer.Margin" Value="{StaticResource PageHeaderContentLeftRightBottomMargin}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionMode">
                <VisualState x:Name="None"/>
                <VisualState x:Name="Multiple">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="pageHeaderTitleContentBarContainer.Child.Visibility" Value="Collapsed"/>
                        <Setter Target="pageHeaderTitleContentBarContainer.Opacity" Value="0"/>
                        <Setter Target="pageHeaderSelectionControlsBar.IsEnabled" Value="True"/>
                        <Setter Target="pageHeaderSelectionControlsBar.Visibility" Value="Visible"/>
                        <Setter Target="pageHeaderSelectionControlsBarContainer.Opacity" Value="1"/>
                    </VisualState.Setters>
                    <VisualState.Storyboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="pageHeaderTitleContentBarContainer"
                                             Storyboard.TargetProperty="Child.Opacity"
                                             From="1"
                                             To="0"
                                             Duration="{StaticResource ShortAnimationDuration}"/>
                            <DoubleAnimation Storyboard.TargetName="pageHeaderSelectionControlsBar"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="{StaticResource ShortAnimationDuration}"/>
                        </Storyboard>
                    </VisualState.Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="topHeader" Padding="{StaticResource ContentExtraLargeLeftRightDefaultTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Rectangle x:Name="background" Grid.ColumnSpan="2"/>
            <local:CoverArtImage x:Name="image"
                                 Margin="{StaticResource ContentMargin}"
                                 VerticalAlignment="Center"
                                 ImageContext="DetailsPage">
                <i:Interaction.Behaviors>
                    <behaviors:TextScaleFactorBehavior x:Name="textScaleFactor"
                                                       Width="{StaticResource CoverArtHeaderLargeSize}"
                                                       Height="{StaticResource CoverArtHeaderLargeSize}"/>
                </i:Interaction.Behaviors>
            </local:CoverArtImage>
            <Grid Margin="{StaticResource ContentTopRightBottomMediumMargin}" Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="title" Style="{StaticResource HeaderTitle}"/>
                <local:MetadataControl x:Name="subtitle"
                                       Grid.Row="1"
                                       AlternateBrush="{ThemeResource SystemFillColorNeutralBrush}"
                                       Style="{StaticResource HeaderSubTitle}"/>
                <local:MetadataControl x:Name="additionalInformation"
                                       Grid.Row="2"
                                       Margin="{StaticResource ContentLargeBottomSpacing}">
                    <local:MetadataControl.TextBlockStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Style>
                    </local:MetadataControl.TextBlockStyle>
                </local:MetadataControl>
                <Border x:Name="commandBarCell" Grid.Row="3"/>
                <Border x:Name="commandBarContainer"
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <CommandBar x:Name="commandBar"
                                x:Load="False"
                                DefaultLabelPosition="Right">
                        <CommandBar.PrimaryCommands>
                            <AppBarButton>
                                <AppBarButton.Resources>
                                    <ResourceDictionary Source="../Styles/AccentuatedAppBarButtonResources.xaml"/>
                                </AppBarButton.Resources>
                                <AppBarButton.Icon>
                                    <FontIcon VerticalAlignment="Center"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton/>
                            <AppBarButton x:Uid="AddToButton">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="{StaticResource PlayQueueAddItemsGlyph}"/>
                                </AppBarButton.Icon>
                                <i:Interaction.Behaviors>
                                    <behaviors:MenuFlyoutItemsDynamicLoadBehavior/>
                                </i:Interaction.Behaviors>
                            </AppBarButton>
                            <AppBarButton/>
                            <AppBarButton/>
                            <AppBarButton/>
                            <AppBarButton/>
                            <AppBarButton/>
                            <AppBarButton/>
                        </CommandBar.PrimaryCommands>
                    </CommandBar>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="pageHeaderBarContainer"
              Margin="{StaticResource PageHeaderContentExtraLargeLeftRightDefaultBottomMargin}"
              Row="1">
            <i:Interaction.Behaviors>
                <behaviors:TextScaleFactorBehavior MinHeight="{StaticResource PageHeaderSelectionCommandBarMinHeight}"/>
            </i:Interaction.Behaviors>
            <Border x:Name="pageHeaderSelectionControlsBarContainer" Opacity="0">
                <local:SelectionControlsBar x:Name="pageHeaderSelectionControlsBar"
                                            x:Load="False"
                                            IsEnabled="False"
                                            Visibility="Collapsed"/>
            </Border>
            <Border x:Name="pageHeaderTitleContentBarContainer" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
