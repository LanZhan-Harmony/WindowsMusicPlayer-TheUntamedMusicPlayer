<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.CDRipSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock x:Uid="CDRipSettingsControlFormatSectionTitle" Style="{StaticResource ContentDialogSubtitle}"/>
        <TextBlock x:Uid="CDRipSettingsControlFormatSectionText" Style="{StaticResource Body}"/>
        <ComboBox Margin="{StaticResource ContentLargeBottomSpacing}" DisplayMemberPath="Label"/>
        <TextBlock x:Uid="CDRipSettingsControlBitrateSectionTitle" Style="{StaticResource ContentDialogSubtitle}"/>
        <TextBlock x:Uid="CDRipSettingsControlBitrateSectionText" Style="{StaticResource Body}"/>
        <ComboBox DisplayMemberPath="Label"/>
    </StackPanel>
</UserControl>
