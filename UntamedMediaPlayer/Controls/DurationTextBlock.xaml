<?xml version="1.0" encoding="utf-8" ?>
<Control x:Class="UntamedMediaPlayer.Controls.DurationTextBlock"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="using:UntamedMediaPlayer.Controls"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d">
    <Control.Style>
        <Style TargetType="local:DurationTextBlock">
            <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:DurationTextBlock">
                        <TextBlock x:Name="Duration" AutomationProperties.AccessibilityView="Raw"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Control.Style>
</Control>
