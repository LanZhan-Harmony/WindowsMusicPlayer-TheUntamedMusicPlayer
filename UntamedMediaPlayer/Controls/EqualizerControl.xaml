<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.EqualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EqualizerYAxisLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="{StaticResource ElementTopBottomMargin}" Orientation="Horizontal">
            <TextBlock x:Name="presetLabel"
                       x:Uid="EqualizerPresetTextBlock"
                       Margin="{StaticResource ElementRightMargin}"
                       Padding="0,0,0,1"
                       VerticalAlignment="Center"/>
            <ComboBox VerticalAlignment="Center" DisplayMemberPath="Item1"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Height="{StaticResource EqualizerSliderHeight}" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource EqualizerYAxisLabelTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource EqualizerYAxisLabelTextBlockStyle}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource EqualizerYAxisLabelTextBlockStyle}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource EqualizerYAxisLabelTextBlockStyle}"/>
                <TextBlock Grid.Row="4" Style="{StaticResource EqualizerYAxisLabelTextBlockStyle}"/>
            </Grid>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled">
                <StackPanel Margin="{StaticResource ContentBottomSpacing}" Orientation="Horizontal">
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                    <local:EqualizerBandControl/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <CheckBox x:Uid="EqualizerMoveNeighboringSlidersTogetherCheckBox"
                  Grid.Row="2"
                  Margin="{StaticResource ElementTopMargin}"/>
    </Grid>
</UserControl>