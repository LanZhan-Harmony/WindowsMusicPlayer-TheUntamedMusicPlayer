<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Controls.DisplayModeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:UntamedMediaPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
        <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="SystemControlTransparentBrush"/>
        <Style x:Name="DisplayModeSelectorNavigationView"
               x:Key="DisplayModeSelectorNavigationView"
               TargetType="NavigationView">
            <Setter Property="IsBackButtonVisible" Value="Collapsed"/>
            <Setter Property="IsSettingsVisible" Value="False"/>
            <Setter Property="PaneDisplayMode" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="NavigationView">
                        <Grid x:Name="RootGrid">
                            <StackPanel x:Name="TopNavArea"
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Canvas.ZIndex="1"
                                        XYFocusKeyboardNavigation="Enabled">
                                <Grid x:Name="TopNavGrid"
                                      BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"
                                      Visibility="{Binding TemplateSettings.TopPaneVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="PaneCustomContentOnTopPane"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"/>
                                    <ItemsRepeater x:Name="TopFooterMenuItemsHost"
                                                   Grid.Column="1"
                                                   AutomationProperties.AccessibilityView="Content">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal"/>
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <NavigationView x:Name="rootNavigationView" Style="{StaticResource DisplayModeSelectorNavigationView}">
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="ListViewDisplayMode" x:Uid="ListViewDisplayMode">
                <i:Interaction.Behaviors>
                    <behaviors:LiveAccessKeyBehavior AccessVirtualKey="C,L"/>
                </i:Interaction.Behaviors>
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="{StaticResource ListViewGlyph}"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="GridViewDisplayMode" x:Uid="GridViewDisplayMode">
                <i:Interaction.Behaviors>
                    <behaviors:LiveAccessKeyBehavior AccessVirtualKey="C,G"/>
                </i:Interaction.Behaviors>
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="{StaticResource GridViewGlyph}"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
    </NavigationView>
</UserControl>
