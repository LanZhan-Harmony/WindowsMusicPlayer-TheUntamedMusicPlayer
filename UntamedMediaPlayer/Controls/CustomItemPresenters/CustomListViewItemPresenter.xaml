                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForeground}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForeground}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForeground}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NowPlayingPointerOverMultiSelectionMode">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}"/>
                                            <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                            <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                            <Setter Target="IsCurrentItemIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="TrackNumber.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="MediaTypeIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Title.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="InformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="SecondaryInformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NowPlayingPressedMultiSelectionMode">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ListViewItemBackgroundPressed}"/>
                                            <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                            <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                            <Setter Target="IsCurrentItemIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="TrackNumber.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="MediaTypeIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Title.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="InformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="SecondaryInformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NowPlayingSelectedMultiSelectionMode">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource TrackListViewItemBackgroundSelected}"/>
                                            <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                            <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                            <Setter Target="IsCurrentItemIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="TrackNumber.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="MediaTypeIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Title.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="InformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="SecondaryInformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NowPlayingSelectedPointerOverMultiSelectionMode">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}"/>
                                            <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                            <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                            <Setter Target="IsCurrentItemIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="TrackNumber.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="MediaTypeIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Title.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="InformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="SecondaryInformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NowPlayingSelectedPressedMultiSelectionMode">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ListViewItemBackgroundPressed}"/>
                                            <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                            <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                            <Setter Target="IsCurrentItemIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="TrackNumber.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="MediaTypeIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Title.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Genre.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="Duration.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="InformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                            <Setter Target="SecondaryInformationText.Foreground" Value="{ThemeResource NowPlayingTrackForegroundHighlighted}"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ReorderHintStates">

                                    <VisualState x:Name="NoReorderHint"/>
                                    <VisualState x:Name="BottomReorderHint">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DragOverThemeAnimation Direction="Bottom"
                                                                        ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                                        Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="TopReorderHint">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DragOverThemeAnimation Direction="Top"
                                                                        ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                                        Storyboard.TargetName="Root"/>

                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="RightReorderHint">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DragOverThemeAnimation Direction="Right"
                                                                        ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                                        Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="LeftReorderHint">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DragOverThemeAnimation Direction="Left"
                                                                        ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                                        Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2" To="NoReorderHint"/>
                                    </VisualStateGroup.Transitions>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DragStates">
                                    <VisualState x:Name="NotDragging"/>
                                    <VisualState x:Name="Dragging">
                                        <VisualState.Setters>
                                            <Setter Target="MultiSelect.Visibility" Value="Collapsed"/>
                                            <Setter Target="ResponsiveStackPanel.Visibility" Value="Collapsed"/>
                                            <Setter Target="AlternativeContentForDrag.Visibility" Value="Visible"/>
                                            <Setter Target="Root.HorizontalAlignment" Value="Left"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemDragThemeOpacity}"
                                                                 Duration="0"/>
                                                <DragItemThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MultipleDraggingPrimary">
                                        <VisualState.Setters>
                                            <Setter Target="MultiSelect.Visibility" Value="Collapsed"/>
                                            <Setter Target="ResponsiveStackPanel.Visibility" Value="Collapsed"/>
                                            <Setter Target="AlternativeContentForDrag.Visibility" Value="Visible"/>
                                            <Setter Target="Root.HorizontalAlignment" Value="Left"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemDragThemeOpacity}"
                                                                 Duration="0"/>
                                                <DragItemThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MultipleDraggingSecondary"/>
                                    <VisualState x:Name="DraggedPlaceholder"/>
                                    <VisualState x:Name="DraggingTarget"/>
                                    <VisualState x:Name="Reordering">
                                        <VisualState.Setters>
                                            <Setter Target="MultiSelect.Visibility" Value="Collapsed"/>
                                            <Setter Target="ResponsiveStackPanel.Visibility" Value="Collapsed"/>
                                            <Setter Target="AlternativeContentForDrag.Visibility" Value="Visible"/>
                                            <Setter Target="Root.HorizontalAlignment" Value="Left"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemReorderThemeOpacity}"
                                                                 Duration="0:0:0.240"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="ReorderingTarget">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeOpacity}"
                                                                 Duration="0:0:0.240"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                                 Duration="0:0:0.240"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MultipleReorderingPrimary">
                                        <VisualState.Setters>
                                            <Setter Target="MultiSelect.Visibility" Value="Collapsed"/>
                                            <Setter Target="ResponsiveStackPanel.Visibility" Value="Collapsed"/>
                                            <Setter Target="AlternativeContentForDrag.Visibility" Value="Visible"/>
                                            <Setter Target="Root.HorizontalAlignment" Value="Left"/>
                                        </VisualState.Setters>
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemDragThemeOpacity}"
                                                                 Duration="0:0:0.240"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="ReorderedPlaceholder">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <FadeOutThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="DragOver">
                                        <VisualState.Storyboard>
                                            <Storyboard>
                                                <DropTargetItemThemeAnimation Storyboard.TargetName="Root"/>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2" To="NotDragging"/>
                                    </VisualStateGroup.Transitions>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="RipOperationStates">
                                    <VisualState x:Name="DefaultRipStatus"/>
                                    <VisualState x:Name="RipInProgress">
                                        <VisualState.Setters>
                                            <Setter Target="RipStatusLabel.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="RipSuccess">
                                        <VisualState.Setters>
                                            <Setter Target="RipStatusIcon.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="RipFailed">
                                        <VisualState.Setters>
                                            <Setter Target="RipStatusIcon.Visibility" Value="Visible"/>
                                            <Setter Target="RipStatusIcon.Glyph" Value="{StaticResource MediaItemErrorBadgeGlyph}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="InformationLinkStates">
                                    <VisualState x:Name="InformationLinkDefault"/>
                                    <VisualState x:Name="InformationLinkNotInteractive">
                                        <VisualState.Setters>
                                            <Setter Target="InformationButton.Visibility" Value="Collapsed"/>
                                            <Setter Target="InformationText.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SecondaryInformationLinkStates">
                                    <VisualState x:Name="SecondaryInformationLinkDefault"/>
                                    <VisualState x:Name="SecondaryInformationLinkNotInteractive">
                                        <VisualState.Setters>
                                            <Setter Target="SecondaryInformationButton.Visibility" Value="Collapsed"/>
                                            <Setter Target="SecondaryInformationText.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="MultiSelect"
                                  Width="28"
                                  Height="{StaticResource CheckBoxHeight}">
                                <ctrlEx:CheckboxEx x:Name="MultiSelectCheckbox"
                                                   x:Uid="SelectionCheckBox"
                                                   MinWidth="0"
                                                   MinHeight="32"
                                                   Padding="0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed">
                                    <animations:Implicit.ShowAnimations>
                                        <animations:OpacityAnimation From="0"
                                                                     To="1"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    </animations:Implicit.ShowAnimations>
                                </ctrlEx:CheckboxEx>
                                <ctrl:MediaTypeIcon x:Name="IsCurrentItemIcon"
                                                    Margin="{StaticResource ContentSmallRightSpacing}"
                                                    VerticalAlignment="Center"
                                                    IsPlaying="{TemplateBinding IsCurrentItem}"
                                                    MediaType="{TemplateBinding MediaType}"
                                                    Visibility="Collapsed">
                                    <animations:Implicit.ShowAnimations>
                                        <animations:OpacityAnimation From="0"
                                                                     To="1"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    </animations:Implicit.ShowAnimations>
                                </ctrl:MediaTypeIcon>
                            </Grid>
                            <ctrl:ResponsiveHorizontalStackPanel x:Name="ResponsiveStackPanel"
                                                                 Grid.Column="1"
                                                                 TabFocusNavigation="Local">
                                <Grid ctrl:ResponsiveHorizontalStackPanel.StretchFactor="2" ctrl:ResponsiveHorizontalStackPanel.UnstretchedWidth="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid MinWidth="16" Margin="{StaticResource ElementRightMargin}">
                                        <TextBlock x:Name="Spacer"
                                                   Margin="0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.AccessibilityView="Raw"
                                                   HorizontalTextAlignment="Right"
                                                   Opacity="0"
                                                   Text="00.."/>
                                        <TextBlock x:Name="TrackNumber"
                                                   Margin="0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   HorizontalTextAlignment="Right"
                                                   Visibility="Collapsed"/>
                                        <ctrl:MediaTypeIcon x:Name="MediaTypeIcon"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            MediaType="{TemplateBinding MediaType}"
                                                            Visibility="Collapsed"/>
                                        <ctrlEx:ButtonEx x:Name="PlayButton"
                                                         x:Uid="PlayButton"
                                                         Margin="-5,0"
                                                         Padding="5,5,5,6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource TextButtonStyle}"
                                                         Visibility="Collapsed">
                                            <FontIcon VerticalAlignment="Center" Glyph="{StaticResource PlayCommandGlyph}"/>
                                        </ctrlEx:ButtonEx>
                                    </Grid>
                                    <FontIcon x:Name="PlayQueueErrorIcon"
                                              x:Uid="PlayQueueErrorIcon"
                                              Grid.Column="1"
                                              Margin="{StaticResource ElementRightMargin}"
                                              VerticalAlignment="Center"
                                              Glyph="{StaticResource MediaItemErrorBadgeGlyph}"
                                              ToolTipService.ToolTip="{TemplateBinding ToolTip}"
                                              Visibility="{x:Bind HasPlaybackError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock x:Name="Title" Grid.Column="2">
                                        <animations:Implicit.Animations>
                                            <animations:Vector3Animation Target="Offset" Duration="{StaticResource ShortAnimationDuration}"/>
                                        </animations:Implicit.Animations>
                                    </TextBlock>
                                </Grid>
                                <Grid x:Name="Information"
                                      Padding="{StaticResource TrackHyperlinkButtonMargin}"
                                      ctrl:ResponsiveHorizontalStackPanel.FallOffOrder="4"
                                      ctrl:ResponsiveHorizontalStackPanel.StretchFactor="2"
                                      ctrl:ResponsiveHorizontalStackPanel.UnstretchedWidth="120">
                                    <HyperlinkButton x:Name="InformationButton">
                                        <TextBlock x:Name="InformationLinkText" Style="{StaticResource HyperlinkTextButton}"/>
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding ElementName=InformationLinkText, Path=Text}" IsEnabled="{Binding ElementName=InformationLinkText, Path=IsTextTrimmed}"/>
                                        </ToolTipService.ToolTip>
                                    </HyperlinkButton>
                                    <TextBlock x:Name="InformationText"
                                               Padding="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <Grid x:Name="SecondaryInformation"
                                      Padding="{StaticResource TrackHyperlinkButtonMargin}"
                                      ctrl:ResponsiveHorizontalStackPanel.FallOffOrder="3"
                                      ctrl:ResponsiveHorizontalStackPanel.StretchFactor="1"
                                      ctrl:ResponsiveHorizontalStackPanel.UnstretchedWidth="120">
                                    <HyperlinkButton x:Name="SecondaryInformationButton">
                                        <TextBlock x:Name="SecondaryInformationLinkText" Style="{StaticResource HyperlinkTextButton}"/>
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding ElementName=SecondaryInformationLinkText, Path=Text}" IsEnabled="{Binding ElementName=SecondaryInformationLinkText, Path=IsTextTrimmed}"/>
                                        </ToolTipService.ToolTip>
                                    </HyperlinkButton>
                                    <TextBlock x:Name="SecondaryInformationText"
                                               Padding="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <Grid Padding="{StaticResource ContentLeftSpacing}" ctrl:ResponsiveHorizontalStackPanel.FallOffOrder="1">
                                    <TextBlock AutomationProperties.AccessibilityView="Raw"
                                               Opacity="0"
                                               Text="0000"/>
                                    <TextBlock x:Name="ReleaseYear"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="Genre"
                                           Padding="{StaticResource ContentLeftSpacing}"
                                           ctrl:ResponsiveHorizontalStackPanel.FallOffOrder="2"
                                           ctrl:ResponsiveHorizontalStackPanel.StretchFactor="1"
                                           ctrl:ResponsiveHorizontalStackPanel.UnstretchedWidth="120"/>
                                <Grid Padding="{StaticResource ContentLeftSpacing}">
                                    <TextBlock AutomationProperties.AccessibilityView="Raw"
                                               Opacity="0"
                                               Text="00:00:00"/>
                                    <TextBlock x:Name="Duration"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Right"/>
                                </Grid>
                                <Grid x:Name="RipStatusGrid"
                                      Padding="{StaticResource ContentLeftSpacing}"
                                      ctrl:ResponsiveHorizontalStackPanel.StretchFactor="1"
                                      ctrl:ResponsiveHorizontalStackPanel.UnstretchedWidth="112"
                                      DataContext="{x:Bind RipStatusLabel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="RipStatusIcon"
                                              Margin="{StaticResource ElementRightMargin}"
                                              VerticalAlignment="Center"
                                              Glyph="{StaticResource CheckMarkGlyph}"
                                              Visibility="Collapsed"/>
                                    <TextBlock x:Name="RipStatusText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"/>
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind RipStatusLabel.Text, Mode=OneWay}" IsEnabled="{x:Bind RipStatusLabel.IsTextTrimmed, Mode=OneWay}"/>
                                    </ToolTipService.ToolTip>
                                </Grid>
                            </ctrl:ResponsiveHorizontalStackPanel>
                            <TextBlock x:Name="AlternativeContentForDrag"
                                       Text="{x:Bind ParentListViewItem.TemplateSettings.DragItemsCount, Converter={StaticResource DragItemsCountConverter}}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </ListViewItemPresenter.Style>
</ListViewItemPresenter>
