<?xml version="1.0" encoding="utf-8" ?>
<MediaPlayerElement x:Class="UntamedMediaPlayer.Controls.CustomMediaPlayerElement"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:local="using:UntamedMediaPlayer.Controls"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tkConverters="using:CommunityToolkit.WinUI.Converters"
                    mc:Ignorable="d">
    <MediaPlayerElement.Resources>
        <tkConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </MediaPlayerElement.Resources>

    <MediaPlayerElement.Style>
        <Style TargetType="local:CustomMediaPlayerElement">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:CustomMediaPlayerElement">
                        <Page RequestedTheme="{TemplateBinding RequestedTheme}">
                            <Grid x:Name="LayoutRoot">
                                <Border x:Name="MediaPlayerBackground"/>
                                <Image x:Name="PosterImage"
                                       Source="{TemplateBinding PosterSource}"
                                       Stretch="{TemplateBinding Stretch}"
                                       Visibility="Collapsed"/>
                                <ContentPresenter Content="{TemplateBinding MediaVisualization}" Visibility="{x:Bind MediaVisualization.Visibility, Mode=OneWay}"/>
                                <MediaPlayerPresenter x:Name="MediaPlayerPresenter"
                                                      FlowDirection="LeftToRight"
                                                      IsFullWindow="{TemplateBinding IsFullWindow}"
                                                      MediaPlayer="{TemplateBinding MediaPlayer}"
                                                      Stretch="{TemplateBinding Stretch}"/>
                                <Grid x:Name="TimedTextSourcePresenter"
                                      FlowDirection="LeftToRight"
                                      Visibility="{x:Bind AreSubtitlesVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                <ContentPresenter x:Name="TransportControlsPresenter"
                                                  Content="{TemplateBinding TransportControls}"
                                                  Visibility="{x:Bind AreTransportControlsEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                            </Grid>
                        </Page>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </MediaPlayerElement.Style>
</MediaPlayerElement>
