<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="UntamedMediaPlayer.Pages.PlaylistLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:animations="using:CommunityToolkit.WinUI.Animations"
      xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
      xmlns:ctrl="using:UntamedMediaPlayer.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:UntamedMediaPlayer.Helpers"
      xmlns:i="using:Microsoft.Xaml.Interactivity"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tkBehaviors="using:CommunityToolkit.WinUI.Behaviors"
      mc:Ignorable="d">
    <Page.Resources>
        <Flyout x:Key="NewPlaylistFlyout"
                Placement="Bottom"
                ShouldConstrainToRootBounds="False">
            <StackPanel MinWidth="{StaticResource NewPlaylistFlyoutMinWidth}" MaxWidth="{StaticResource NewPlaylistFlyoutMaxWidth}">
                <TextBox x:Name="NewPlaylistNameTextBox"
                         x:Uid="PlaylistNameTextBox"
                         Margin="{StaticResource ContentBottomSpacing}"/>
                <Button x:Uid="CreatePlaylistButton"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Flyout>
    </Page.Resources>

    <i:Interaction.Behaviors>
        <tkBehaviors:FocusBehavior>
            <tkBehaviors:FocusBehavior.Targets>
                <tkBehaviors:FocusTarget/>
                <tkBehaviors:FocusTarget/>
                <tkBehaviors:FocusTarget/>
                <tkBehaviors:FocusTarget/>
            </tkBehaviors:FocusBehavior.Targets>
        </tkBehaviors:FocusBehavior>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto">
                <i:Interaction.Behaviors>
                    <behaviors:RowDefinitionTextScaleFactorBehavior MinHeight="{StaticResource SelectionCommandBarMinHeight}"/>
                </i:Interaction.Behaviors>
            </RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageStates">
                <VisualState x:Name="LibraryAccessDenied">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="noAccessMessageControl.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ContentLoading">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="progress.Visibility" Value="Visible"/>
                        <Setter Target="progress.IsActive" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ContentRefreshing">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="pageHeaderControls.Visibility" Value="Visible"/>
                        <Setter Target="progress.Visibility" Value="Visible"/>
                        <Setter Target="progress.IsActive" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NoData">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="emptyPlaylistLibraryErrorMessage.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DataAvailable">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="playlistsList.Visibility" Value="Visible"/>
                        <Setter Target="pageHeaderControls.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selection">
                    <VisualState.StateTriggers>
                        <StateTrigger/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="playlistsList.Visibility" Value="Visible"/>
                        <Setter Target="playlistsList.IsMultiSelectCheckBoxEnabled" Value="True"/>
                        <Setter Target="playlistsList.IsItemClickEnabled" Value="False"/>
                        <Setter Target="pageHeaderSelectionControlsBar.Visibility" Value="Visible"/>
                        <Setter Target="pageHeaderSelectionControlsBar.IsEnabled" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AdaptiveLayoutMargins">
                <VisualState/>
                <VisualState>
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlaylistsPageTitle.Margin" Value="{StaticResource ContentLeftRightBottomMargin}"/>
                        <Setter Target="noAccessMessageControl.Margin" Value="{StaticResource ContentMargin}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlaylistsPageTitle.Margin" Value="{StaticResource ContentLeftRightBottomMargin}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <helpers:ViewportStateTrigger State="Narrow"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlaylistsPageTitle.Margin" Value="{StaticResource ContentLeftRightBottomMargin}"/>
                        <Setter Target="pageHeaderControls.Margin" Value="{StaticResource ContentLeftRightBottomMargin}"/>
                        <Setter Target="pageHeaderSelectionControlsBarContainer.Margin" Value="{StaticResource ContentLeftRightBottomMargin}"/>
                        <Setter Target="playlistsList.Padding" Value="{StaticResource GridViewPaddingForNarrowMode}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="PlaylistsPageTitle"
                   x:Uid="PlaylistsPageTitle"
                   Margin="{StaticResource ContentExtraLargeLeftRightDefaultBottomMargin}"
                   Style="{StaticResource TitleNoWrap}"/>
        <ctrl:EmptyPageMessageControl x:Name="emptyPlaylistLibraryErrorMessage"
                                      x:Uid="EmptyPlaylistLibraryErrorMessage"
                                      Grid.Row="1"
                                      Grid.RowSpan="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      x:Load="False"
                                      CommandButtonFlyout="{StaticResource NewPlaylistFlyout}"
                                      CommandIcon="{StaticResource NewPlaylistGlyph}"
                                      ImageSource="ms-appx:///Assets/PlaylistGradient.svg"
                                      Visibility="Collapsed"/>
        <ctrl:ErrorMessageControl x:Name="noAccessMessageControl"
                                  x:Uid="NoMusicLibraryAccessErrorMessage"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Margin="{StaticResource ContentExtraLargeLeftRightDefaultTopBottomMargin}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  x:Load="False"
                                  Visibility="Collapsed"/>
        <CommandBar x:Name="pageHeaderControls"
                    Grid.Row="1"
                    Margin="{StaticResource ContentExtraLargeLeftRightDefaultBottomMargin}"
                    VerticalContentAlignment="Center"
                    DefaultLabelPosition="Right"
                    KeyTipPlacementMode="Top"
                    Visibility="Collapsed">
            <CommandBar.Content>
                <Button x:Uid="NewPlaylistButton"
                        Flyout="{StaticResource NewPlaylistFlyout}"
                        Style="{StaticResource NewPlaylistButton}"/>
            </CommandBar.Content>
            <CommandBar.PrimaryCommands>
                <ctrl:SortAndFilterControl x:Uid="SortControl">
                    <i:Interaction.Behaviors>
                        <behaviors:MenuFlyoutSelectableItemsDynamicLoadBehavior Converter="{StaticResource SortAndFilterConverter}"/>
                    </i:Interaction.Behaviors>
                </ctrl:SortAndFilterControl>
            </CommandBar.PrimaryCommands>
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation From="0"
                                             To="1"
                                             Duration="{StaticResource ShortAnimationDuration}"/>
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation From="1"
                                             To="0"
                                             Duration="{StaticResource ShortAnimationDuration}"/>
            </animations:Implicit.HideAnimations>
        </CommandBar>
        <Border x:Name="pageHeaderSelectionControlsBarContainer"
                Grid.Row="1"
                Margin="{StaticResource ContentExtraLargeLeftRightDefaultBottomMargin}">
            <ctrl:SelectionControlsBar x:Name="pageHeaderSelectionControlsBar"
                                       x:Load="False"
                                       IsEnabled="False"
                                       Visibility="Collapsed">
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation From="0"
                                                 To="1"
                                                 Duration="{StaticResource ShortAnimationDuration}"/>
                </animations:Implicit.ShowAnimations>
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation From="1"
                                                 To="0"
                                                 Duration="{StaticResource ShortAnimationDuration}"/>
                </animations:Implicit.HideAnimations>
            </ctrl:SelectionControlsBar>
        </Border>
        <ctrl:GridViewEx x:Name="playlistsList"
                         Grid.Row="2"
                         CanDragItems="True"
                         IsItemClickEnabled="True"
                         IsMultiSelectCheckBoxEnabled="False"
                         IsSynchronizedWithCurrentItem="False"
                         SelectionMode="None"
                         Style="{StaticResource GridViewExtraLargeContentStyle}"
                         UseCustomItemPresenterWithDisplayMode="CardItemPresenter"
                         Visibility="Collapsed">
            <ctrl:GridViewEx.ItemsMenuFlyout>
                <MenuFlyout/>
            </ctrl:GridViewEx.ItemsMenuFlyout>
            <i:Interaction.Behaviors>
                <behaviors:ListViewBasePersistentScrollingBehavior/>
                <behaviors:SelectionManagerBehavior/>
                <behaviors:DragConfigurationBehavior Command="{StaticResource playlistsDropCommandAdapter}"/>
                <behaviors:RestoreListViewItemFocusOnVisualStateChangeBehavior/>
            </i:Interaction.Behaviors>
        </ctrl:GridViewEx>
        <ProgressRing x:Name="progress"
                      Grid.Row="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="False"
                      Visibility="Collapsed"/>
    </Grid>
</Page>