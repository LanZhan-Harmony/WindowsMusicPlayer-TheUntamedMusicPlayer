<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="UntamedMediaPlayer.Pages.NavigationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:UntamedMediaPlayer.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:UntamedMediaPlayer.Strings"
             mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
        <x:Double x:Key="NavigationViewContentMargin">0</x:Double>
        <x:Double x:Key="NavigationViewContentGridCornerRadius">0</x:Double>
    </UserControl.Resources>

    <Grid KeyTipPlacementMode="Right">
        <Grid x:Name="AppTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Canvas.ZIndex="1">
            <ImageIcon Width="16"
                       Height="16"
                       Margin="12,0,0,0"
                       HorizontalAlignment="Left"
                       Source="/Assets/AppIcon/Icon.ico"/>
            <TextBlock Margin="40,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind strings:Resources.AppDisplayName}"
                       TextWrapping="NoWrap"/>
        </Grid>
        <NavigationView x:Name="NavigationViewControl"
                        BackRequested="NavigationViewControl_BackRequested"
                        Canvas.ZIndex="1"
                        DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="{x:Bind NavigationFrame.CanGoBack, Mode=OneWay}"
                        IsSettingsVisible="True">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Uid="Shell_Search"
                                AccessKey="NE"
                                AutomationProperties.Name="Search"
                                QueryIcon="Find"
                                ToolTipService.ToolTip="Ctrl+E">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" Modifiers="Control"/>
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Shell_Home"
                                    AccessKey="NO"
                                    Icon="{helpers:FontIcon Glyph=&#xE80F;}"
                                    Tag="HomePage">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control,Shift"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_MusicLibrary"
                                    AccessKey="NS"
                                    Icon="{helpers:FontIcon Glyph=&#xE940;}"
                                    Tag="MusicLibraryPage">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem x:Uid="Shell_PlayQueue"
                                    AccessKey="NQ"
                                    Icon="{helpers:FontIcon Glyph=&#xE93F;}"
                                    Tag="PlayQueuePage">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" Modifiers="Control"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PlaylistsNavItem"
                                    x:Uid="Shell_PlayLists"
                                    AccessKey="NP"
                                    Icon="{helpers:FontIcon Glyph=&#xED3B;}"
                                    Tag="PlayListsPage">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control"/>
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavigationFrame" AllowDrop="True"/>
        </NavigationView>
    </Grid>
</UserControl>