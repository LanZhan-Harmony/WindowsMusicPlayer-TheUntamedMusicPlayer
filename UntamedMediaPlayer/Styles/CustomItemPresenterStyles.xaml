<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
                    xmlns:behaviors="using:UntamedMediaPlayer.Behaviors"
                    xmlns:ctrl="using:UntamedMediaPlayer.Controls"
                    xmlns:helpers="using:UntamedMediaPlayer.Helpers"
                    xmlns:i="using:Microsoft.Xaml.Interactivity"
                    xmlns:presenters="using:UntamedMediaPlayer.Controls.CustomItemPresenters"
                    xmlns:tkConverters="using:CommunityToolkit.WinUI.Converters">
    <tkConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <DataTemplate x:Key="VideoListItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" Glyph="{StaticResource NowPlayingVideoGlyph}"/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource ListViewItemTextBlockStyle}"/>
            <Button x:Uid="PlayButton"
                    Grid.Column="2"
                    Margin="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource TextButtonStyle}">
                <FontIcon VerticalAlignment="Center" Glyph="{StaticResource PlayCommandGlyph}"/>
            </Button>
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Style="{StaticResource ListViewItemTextBlockStyle}"/>
            <TextBlock Grid.Column="5"
                       VerticalAlignment="Center"
                       Style="{StaticResource ListViewItemTextBlockStyle}"/>
        </Grid>
    </DataTemplate>

    <x:String x:Key="TwoEmptyLines">&#10;&#10;</x:String>
    <Thickness x:Key="TrackHyperlinkButtonMargin">5,0,-11,0</Thickness>

    <Style x:Key="MediaListViewItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="{StaticResource ContentSmallMargin}"/>
    </Style>

    <Style x:Key="MediaListItemsControlItemContainerStyle" TargetType="ContentPresenter">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="{StaticResource ContentSmallMargin}"/>
    </Style>

    <Style x:Key="MediaItemDataTemplateTitleStyle"
           BasedOn="{StaticResource BodyTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="Padding" Value="{StaticResource ElementSideMargin}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MediaItemDataTemplateSubtitleStyle"
           BasedOn="{StaticResource SubtleCaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Padding" Value="{StaticResource ElementSideMargin}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <DataTemplate x:Key="MediaGroupItemTemplate">
        <TextBlock AutomationProperties.AccessibilityView="Raw"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"/>
    </DataTemplate>

    <Style x:Key="ListViewItemTextBlockStyle"
           BasedOn="{StaticResource BodyTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ListViewItemTextBlockFontSize}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <x:Double x:Key="ListViewItemTextBlockFontSize">12</x:Double>

    <Style x:Key="DefaultSimpleCardItemPresenter" TargetType="presenters:SimpleCardItemPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="presenters:SimpleCardItemPresenter">
                    <Grid x:Name="root"
                          Margin="{StaticResource ElementSmallBottomDefaultRightMargin}"
                          Background="#00FFFFFF"
                          BorderBrush="#00FFFFFF"
                          BorderThickness="{ThemeResource PageHeaderBorderThickness}"
                          CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="AdaptiveLayout">
                                <VisualState x:Name="Default"/>
                                <VisualState x:Name="Narrow">
                                    <VisualState.StateTriggers>
                                        <helpers:ViewportStateTrigger State="Narrow"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="root.Margin" Value="{StaticResource ElementBottomMargin}"/>
                                        <Setter Target="mainPanel.Width" Value="Auto"/>
                                        <Setter Target="mainPanel.Orientation" Value="Horizontal"/>
                                        <Setter Target="coverArtImage.Width" Value="{StaticResource CoverArtSmallSize}"/>
                                        <Setter Target="coverArtImage.Height" Value="{StaticResource CoverArtSmallSize}"/>
                                        <Setter Target="placeHolderPanel.VerticalAlignment" Value="Center"/>
                                        <Setter Target="contentPanel.VerticalAlignment" Value="Center"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel x:Name="mainPanel" Width="{StaticResource CoverArtListItemSize}">
                            <ctrl:CoverArtImage x:Name="coverArtImage"
                                                Width="{StaticResource CoverArtListItemSize}"
                                                Height="{StaticResource CoverArtListItemSize}"
                                                ImageContext="LibraryPage"/>
                            <Grid>
                                <StackPanel x:Name="placeHolderPanel" Opacity="0">
                                    <TextBlock AutomationProperties.AccessibilityView="Raw"
                                               Style="{StaticResource MediaItemDataTemplateTitleStyle}"
                                               Text="{StaticResource TwoEmptyLines}"/>
                                    <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource MediaItemDataTemplateSubtitleStyle}"/>
                                </StackPanel>
                                <StackPanel x:Name="contentPanel">
                                    <TextBlock x:Name="title"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Style="{StaticResource MediaItemDataTemplateTitleStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding ElementName=title, Path=Text}" IsEnabled="{Binding ElementName=title, Path=IsTextTrimmed}"/>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                    <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource MediaItemDataTemplateSubtitleStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultSimpleCardItemPresenter}" TargetType="presenters:SimpleCardItemPresenter"/>

    <Style x:Key="DefaultCardItemPresenterStyle" TargetType="presenters:CardItemPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="KeyTipPlacementMode" Value="Right"/>
        <Setter Property="Margin" Value="{StaticResource ContentSmallBottomSpacing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="presenters:CardItemPresenter">
                    <Grid x:Name="Root"
                          Background="#00FFFFFF"
                          BorderBrush="#00FFFFFF"
                          BorderThickness="{ThemeResource PageHeaderBorderThickness}"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="RoundButtonStroke"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="RoundButtonStrokePressed"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="RoundButtonStrokePointerOver"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="RoundButtonFill"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="RoundButtonFillPressed"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="RoundButtonFillPointerOver"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="RoundButtonStroke"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="RoundButtonStrokePressed"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="RoundButtonStrokePointerOver"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="RoundButtonFill"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="RoundButtonFillPressed"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="RoundButtonFillPointerOver"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast"/>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RootScale"/>
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="PointerOverSelected"/>
                                <VisualState x:Name="PressedSelected"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="States">
                                <VisualState x:Name="DefaultNormal">
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackground}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPointerOver}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                        <Setter Target="PlayButton.Visibility" Value="Visible"/>
                                        <Setter Target="MoreButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPressed}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                        <Setter Target="PlayButton.Visibility" Value="Visible"/>
                                        <Setter Target="MoreButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultNoCheckboxPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPointerOver}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="PlayButton.Visibility" Value="Visible"/>
                                        <Setter Target="MoreButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultNoCheckboxPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPressed}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="PlayButton.Visibility" Value="Visible"/>
                                        <Setter Target="MoreButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultPointerOverMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPointerOver}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultPressedMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPressed}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultSelectedMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackground}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultSelectedPointerOverMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPointerOver}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultSelectedPressedMultiSelectionMode">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource GridViewItemBackgroundPressed}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GridListViewItemBorderBrush}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="True"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="{ThemeResource ListViewItemReorderTargetThemeScale}"
                                                             Duration="0:0:0.240"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ImageSizeStates">
                                <VisualState x:Name="ImageDefaultSize"/>
                                <VisualState x:Name="ImageWideSize">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{TemplateBinding IsWideImage}"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="Content.Width" Value="232"/>
                                        <Setter Target="CoverArtImage.Height" Value="{StaticResource VideoItemCoverHeightSize}"/>
                                        <Setter Target="CoverArtImage.Width" Value="{StaticResource VideoItemCoverWidthSize}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel x:Name="Content" Width="168">
                            <Grid Margin="{StaticResource ContentSmallMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ctrl:CoverArtImage x:Name="CoverArtImage"
                                                    Grid.RowSpan="2"
                                                    Grid.ColumnSpan="2"
                                                    Width="{StaticResource CoverArtListItemSize}"
                                                    Height="{StaticResource CoverArtListItemSize}"
                                                    ImageContext="LibraryPage"/>
                                <ctrl:CheckboxEx x:Name="MultiSelectCheckbox"
                                                 x:Uid="SelectionCheckBox"
                                                 MinWidth="0"
                                                 MinHeight="32"
                                                 Margin="16,8"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Visibility="Collapsed">
                                    <animations:Implicit.ShowAnimations>
                                        <animations:OpacityAnimation From="0"
                                                                     To="1"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    </animations:Implicit.ShowAnimations>
                                </ctrl:CheckboxEx>
                                <ctrl:ButtonEx x:Name="PlayButton"
                                               x:Uid="PlayButton"
                                               Grid.Row="1"
                                               Margin="10,8"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Content="{StaticResource PlayCommandGlyph}"
                                               Style="{StaticResource RoundButtonStyle}"
                                               Visibility="Collapsed"/>
                                <ctrl:ButtonEx x:Name="MoreButton"
                                               x:Uid="MoreButton"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="10,8"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Content="{StaticResource MoreButtonGlyph}"
                                               Style="{StaticResource RoundButtonStyle}"
                                               Visibility="Collapsed">
                                    <ctrl:ButtonEx.Flyout>
                                        <MenuFlyout x:Name="MoreButtonMenuFlyout"/>
                                    </ctrl:ButtonEx.Flyout>
                                </ctrl:ButtonEx>
                            </Grid>
                            <Grid>
                                <StackPanel Opacity="0">
                                    <TextBlock AutomationProperties.AccessibilityView="Raw"
                                               Style="{StaticResource MediaItemDataTemplateTitleStyle}"
                                               Text="{StaticResource TwoEmptyLines}"/>
                                    <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource MediaItemDataTemplateSubtitleStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="title"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Style="{StaticResource MediaItemDataTemplateTitleStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding ElementName=title, Path=Text}" IsEnabled="{Binding ElementName=title, Path=IsTextTrimmed}"/>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                    <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource MediaItemDataTemplateSubtitleStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style BasedOn="{StaticResource DefaultCardItemPresenterStyle}" TargetType="presenters:CardItemPresenter"/>

    <Style TargetType="presenters:CustomListViewItemPresenter">
        <Setter Property="AlternateBackground" Value="{ThemeResource TrackListViewItemAlternateBackground}"/>
        <Setter Property="AlternateBorderBrush" Value="{ThemeResource TrackListViewItemAlternateBorderBrush}"/>
        <Setter Property="Background" Value="{ThemeResource TrackListViewItemBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TrackListViewItemBorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="KeyTipPlacementMode" Value="Right"/>
        <Setter Property="Margin" Value="{StaticResource ContentSmallBottomSpacing}"/>
        <Setter Property="MinHeight" Value="{StaticResource TrackMinHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="presenters:CustomListViewItemPresenter">
                    <Grid x:Name="Root"
                          Margin="4,0"
                          Padding="16,0"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{ThemeResource PageHeaderBorderThickness}"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RootScale"/>
                        </Grid.RenderTransform>
                        <Grid.Resources>
                            <Style x:Key="HyperlinkTextButton"
                                   BasedOn="{StaticResource ListViewItemTextBlockStyle}"
                                   TargetType="TextBlock">
                                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                            <Style BasedOn="{StaticResource ListViewItemTextBlockStyle}" TargetType="TextBlock"/>
                            <Style BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" TargetType="HyperlinkButton">
                                <Setter Property="FontSize" Value="{StaticResource ListViewItemTextBlockFontSize}"/>
                                <Setter Property="Foreground" Value="{ThemeResource ListViewItemHyperlinkButtonForegroundThemeBrush}"/>
                            </Style>
                            <Style BasedOn="{StaticResource InlineMediaFontIcon}" TargetType="FontIcon"/>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="PointerOverSelected"/>
                                <VisualState x:Name="PressedSelected"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="States">
                                <VisualState x:Name="DefaultNormal">
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource TrackListViewItemBackgroundSelected}"/>
                                        <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="Title.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="InformationButton.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="SecondaryInformationButton.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="Genre.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                        <Setter Target="Duration.Foreground" Value="{ThemeResource TrackListViewItemForegroundSelected}"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DefaultPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}"/>
                                        <Setter Target="PlayQueueErrorIcon.Foreground" Value="{ThemeResource ListViewItemForegroundPointerOver}"/>
                                        <Setter Target="Title.Foreground" Value="{ThemeResource ListViewItemForegroundPointerOver}"/>
                                        <Setter Target="ReleaseYear.Foreground" Value="{ThemeResource ListViewItemForegroundPointerOver}"/>
                                        <Setter Target="Genre.Foreground" Value="{ThemeResource ListViewItemForegroundPointerOver}"/>
                                        <Setter Target="Duration.Foreground" Value="{ThemeResource ListViewItemForegroundPointerOver}"/>
                                        <Setter Target="MultiSelectCheckbox.Visibility" Value="Visible"/>
                                        <Setter Target="MultiSelectCheckbox.IsChecked" Value="False"/>
                                        <Setter Target="TrackNumber.Visibility" Value="Collapsed"/>
                                        <Setter Target="MediaTypeIcon.Visibility" Value="Collapsed"/>
                                        <Setter Target="PlayButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="Root"/>
                                        </Storyboard>
                                    </VisualState.Storyboard>
