<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:UntamedMediaPlayer.Controls"
                    xmlns:helpers="using:UntamedMediaPlayer.Helpers"
                    xmlns:i="using:Microsoft.Xaml.Interactivity"
                    xmlns:selectors="using:UntamedMediaPlayer.Controls.CustomDataTemplateSelectors"
                    xmlns:tkBehaviors="using:CommunityToolkit.WinUI.Behaviors">
    <selectors:ModalNotificationTitleTemplateSelector x:Key="ModalNotificationTitleTemplateSelector"
                                                      EditAlbumInfoTitleTemplate="{StaticResource EditAlbumInfoTitleTemplate}"
                                                      EqualizerTitleTemplate="{StaticResource EqualizerTitleTemplate}">
        <selectors:ModalNotificationTitleTemplateSelector.DefaultTemplate>
            <DataTemplate>
                <TextBlock AutomationProperties.HeadingLevel="Level1"
                           FontSize="20"
                           FontWeight="Normal"/>
            </DataTemplate>
        </selectors:ModalNotificationTitleTemplateSelector.DefaultTemplate>
    </selectors:ModalNotificationTitleTemplateSelector>

    <DataTemplate x:Key="EditAlbumInfoTitleTemplate">
        <UserControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <helpers:ViewportStateTrigger State="Narrow"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="hyperlink.(Grid.Row)" Value="1"/>
                                <Setter Target="hyperlink.(Grid.Column)" Value="0"/>
                                <Setter Target="hyperlink.Margin" Value="{StaticResource HyperlinkButtonReverseMargin}"/>
                                <Setter Target="hyperlink.MaxWidth" Value="{StaticResource ContentBoxLargeWidth}"/>
                                <Setter Target="title.MaxWidth" Value="{StaticResource ContentBoxLargeWidth}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <TextBlock x:Name="title"
                           HorizontalAlignment="Left"
                           AutomationProperties.HeadingLevel="Level1"
                           AutomationProperties.LiveSetting="Assertive"
                           FontSize="20"
                           FontWeight="Normal"/>
                <HyperlinkButton x:Name="hyperlink"
                                 x:Uid="UpdateAlbumInfoOnlineButton"
                                 Grid.Column="1"/>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="EqualizerTitleTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.HeadingLevel="Level1"
                       FontSize="20"
                       FontWeight="Normal"/>
            <ToggleSwitch x:Uid="EqualizerEnableDisableToggleSwitch"
                          Grid.Column="1"
                          HorizontalContentAlignment="Right"
                          Style="{StaticResource RightAlignedCompactToggleSwitchStyle}"/>
        </Grid>
    </DataTemplate>

    <selectors:ModalNotificationTemplateSelector x:Key="ModalNotificationTemplateSelector"
                                                 CDRipSettingsTemplate="{StaticResource CDRipSettingsTemplate}"
                                                 EditAlbumInfoTemplate="{StaticResource EditAlbumInfoTemplate}"
                                                 EditMediaInfoTemplate="{StaticResource EditMediaInfoTemplate}"
                                                 EqualizerControlTemplate="{StaticResource EqualizerTemplate}"
                                                 MediaExtensionAcquisitionUserConsentTemplate="{StaticResource MediaExtensionAcquisitionConsentTemplate}"
                                                 MediaPropertiesTemplate="{StaticResource MediaPropertiesTemplate}"
                                                 PlaylistNameDialogTemplate="{StaticResource PlaylistNameDialogTemplate}"
                                                 UrlPickerTemplate="{StaticResource UrlPickerTemplate}">
        <selectors:ModalNotificationTemplateSelector.DefaultTemplate>
            <DataTemplate>
                <ContentControl IsTabStop="True" UseSystemFocusVisuals="True">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </DataTemplate>
        </selectors:ModalNotificationTemplateSelector.DefaultTemplate>
    </selectors:ModalNotificationTemplateSelector>

    <DataTemplate x:Key="CDRipSettingsTemplate">
        <ctrl:CDRipSettingsControl Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"/>
    </DataTemplate>

    <DataTemplate x:Key="EditAlbumInfoTemplate">
        <ctrl:EditAlbumInfo Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"/>
    </DataTemplate>

    <DataTemplate x:Key="EditMediaInfoTemplate">
        <ctrl:EditMediaInfo/>
    </DataTemplate>

    <DataTemplate x:Key="EqualizerTemplate">
        <ctrl:EqualizerControl Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"/>
    </DataTemplate>

    <DataTemplate x:Key="MediaExtensionAcquisitionConsentTemplate" x:Name="MediaExtensionAcquisitionConsentTemplate">
        <UserControl>
            <UserControl.Resources>
                <ResourceDictionary>
                    <StaticResource x:Key="ExpanderHeaderPadding" ResourceKey="ContentMargin"/>
                    <StaticResource x:Key="ExpanderChevronMargin" ResourceKey="ContentTopRightBottomMediumMargin"/>
                </ResourceDictionary>
            </UserControl.Resources>
            <StackPanel Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}">
                <TextBlock Margin="{StaticResource ContentLargeBottomSpacing}" Style="{StaticResource Body}"/>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid Margin="{StaticResource ContentTopRightBottomMediumMargin}" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Margin="{StaticResource ContentRightSpacing}"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AccentButtonBackground}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Image Width="{StaticResource StoreProductImageSize}"
                                       Height="{StaticResource StoreProductImageSize}"
                                       Margin="{StaticResource ElementMargin}"
                                       Stretch="Uniform">
                                    <Image.Source>
                                        <BitmapImage/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource ContentRightSpacing}"
                                        VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource SubTitleNoMargin}"/>
                                <TextBlock Style="{StaticResource SubtleNoMargin}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <TextBlock Style="{StaticResource BodyNoMargin}"/>
                </Expander>
            </StackPanel>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="MediaPropertiesTemplate">
        <ctrl:MediaProperties/>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistNameDialogTemplate">
        <StackPanel Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}">
            <StackPanel.Resources>
                <Style x:Key="PlaylistNameDialogTemplateCoverArtCompactStyle"
                       BasedOn="{StaticResource DefaultCoverArtImageStyle}"
                       TargetType="ctrl:CoverArtImage">
                    <Setter Property="Height" Value="{StaticResource CoverArtCompactSize}"/>
                    <Setter Property="Width" Value="{StaticResource CoverArtCompactSize}"/>
                </Style>
            </StackPanel.Resources>
            <ctrl:CoverArtImage Margin="{StaticResource ContentBottomSpacing}"
                                ImageContext="LibraryPage"
                                ImageType="Playlist"
                                Style="{StaticResource PlaylistNameDialogTemplateCoverArtCompactStyle}"/>
            <TextBox x:Uid="PlaylistNameTextBox"
                     Width="{StaticResource ContentDialogWidth}"
                     HorizontalAlignment="Stretch">
                <i:Interaction.Behaviors>
                    <tkBehaviors:AutoSelectBehavior/>
                </i:Interaction.Behaviors>
            </TextBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="UrlPickerTemplate">
        <TextBox x:Uid="UrlPickerTextBox"
                 MinWidth="{StaticResource ContentDialogWidth}"
                 Margin="{StaticResource ScrollViewerWithHyperLinkInnerMargin}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"/>
    </DataTemplate>

    <Thickness x:Key="ContentDialogContentScrollViewerPaddingWithHyperLinks">12,0</Thickness>
</ResourceDictionary>
