<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:compat="using:UntamedMediaPlayer.Compatibility">
    <compat:SemanticZoomOutTemplateSelector x:Key="SemanticZoomOutTemplateSelector" GroupTemplate="{StaticResource SemanticZoomOutGroupTemplate}"/>

    <DataTemplate x:Key="SemanticZoomOutGroupTemplate">
        <Grid AutomationProperties.AccessibilityView="Raw">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw"
                       Opacity="0"
                       Style="{StaticResource SubTitleNoMargin}"
                       TextAlignment="Center"/>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw"
                       Style="{StaticResource SubTitleNoMargin}"
                       TextAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="SemanticZoomGroupNamesGridViewStyle" TargetType="GridView">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SemanticZoomGroupNamesGridViewItemStyle}"/>
        <Setter Property="ItemTemplateSelector" Value="{StaticResource SemanticZoomOutTemplateSelector}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Margin="{StaticResource ContentMargin}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaximumRowsOrColumns="{StaticResource SemanticZoomGroupNamesGridViewMaximumRowsOrColumns}"
                                   Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ShowsScrollingPlaceholders" Value="False"/>
    </Style>

    <x:Int32 x:Key="SemanticZoomGroupNamesGridViewMaximumRowsOrColumns">8</x:Int32>

    <Style x:Key="SemanticZoomGroupNamesGridViewItemStyle"
           BasedOn="{StaticResource MediaPlayerGridViewItemStyle}"
           TargetType="GridViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource ContentSmallMargin}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="SemanticZoom">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
</ResourceDictionary>
