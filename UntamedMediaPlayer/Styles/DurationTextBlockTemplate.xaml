<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:UntamedMediaPlayer.Controls">
    <Style x:Key="DefaultDurationTextBlockStyle" TargetType="ctrl:DurationTextBlock">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:DurationTextBlock">
                    <TextBlock x:Name="Duration" AutomationProperties.AccessibilityView="Raw"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultDurationTextBlockStyle}" TargetType="ctrl:DurationTextBlock"/>
</ResourceDictionary>
