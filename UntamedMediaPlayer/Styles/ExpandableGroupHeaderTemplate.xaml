<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:UntamedMediaPlayer.Controls">
    <Style x:Key="DefaultExpandableGroupHeader"
           BasedOn="{StaticResource ExpanderHeaderDownStyle}"
           TargetType="ctrl:ExpandableGroupHeader">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
        <Setter Property="Background" Value="#00FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FocusVisualMargin" Value="-3,0,-3,-3"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}"/>
    </Style>

    <Style BasedOn="{StaticResource DefaultExpandableGroupHeader}" TargetType="ctrl:ExpandableGroupHeader"/>
</ResourceDictionary>
