<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:compat="using:UntamedMediaPlayer.Compatibility"
                    xmlns:converters="using:UntamedMediaPlayer.Converters"
                    xmlns:ws="using:Windows.System">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="TrackListViewItemForeground" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="TrackListViewItemForegroundSelected" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="TrackListViewItemBorderBrush" ResourceKey="PageHeaderBorderBrush"/>
            <StaticResource x:Key="TrackListViewItemBackground" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="TrackListViewItemBackgroundSelected" ResourceKey="ControlFillColorSecondary"/>
            <StaticResource x:Key="TrackListViewItemAlternateBorderBrush" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TrackListViewItemAlternateBackground" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TopNavigationViewItemForeground" ResourceKey="TextFillColorSecondaryBrush"/>
            <Color x:Key="ShadowColor">#42000000</Color>
            <SolidColorBrush x:Key="RoundButtonStroke" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
            <SolidColorBrush x:Key="RoundButtonStrokePressed" Color="{ThemeResource ControlStrongStrokeColorDisabled}"/>
            <SolidColorBrush x:Key="RoundButtonStrokePointerOver" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
            <StaticResource x:Key="RoundButtonForegroundPressed" ResourceKey="ButtonForegroundPressed"/>
            <SolidColorBrush x:Key="RoundButtonFill"
                             Opacity="0.7"
                             Color="{ThemeResource SolidBackgroundFillColorSecondary}"/>
            <SolidColorBrush x:Key="RoundButtonFillPressed"
                             Opacity="0.7"
                             Color="{ThemeResource SolidBackgroundFillColorQuarternary}"/>
            <SolidColorBrush x:Key="RoundButtonFillPointerOver"
                             Opacity="0.7"
                             Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>
            <Thickness x:Key="PageHeaderBorderThickness">1</Thickness>
            <StaticResource x:Key="PageHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="PageHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="NowPlayingTrackForeground" ResourceKey="AccentTextFillColorPrimaryBrush"/>
            <StaticResource x:Key="NowPlayingTrackForegroundHighlighted" ResourceKey="AccentTextFillColorPrimaryBrush"/>
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#FF323232"/>
            <Thickness x:Key="MediaTransportControlsTitleSafeBounds">0</Thickness>
            <Thickness x:Key="MTCBorderThickness">0,1,0,0</Thickness>
            <StaticResource x:Key="MTCBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="MTCBackgroundBrush" ResourceKey="ControlOnImageFillColorDefaultBrush"/>
            <StaticResource x:Key="ListViewItemHyperlinkButtonForegroundThemeBrush" ResourceKey="ButtonForegroundThemeBrush"/>
            <StaticResource x:Key="ListViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridListViewItemBorderBrush" ResourceKey="PageHeaderBorderBrush"/>
            <Thickness x:Key="CovertArtBorderThickness">1</Thickness>
            <StaticResource x:Key="CoverArtForegroundBrush" ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBorderBrush" ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
            <Thickness x:Key="ContentDialogTitleMargin">24,24,24,12</Thickness>
            <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="SmokeFillColorDefaultBrush"/>
            <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
            <Thickness x:Key="ContentDialogContentScrollViewerPadding">24,0</Thickness>
            <Thickness x:Key="ContentDialogContentPadding">0,0,0,24</Thickness>
            <Thickness x:Key="CommandBarBorderThicknessOpen">0</Thickness>
            <StaticResource x:Key="CommandBarBorderBrushOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <AcrylicBrush x:Key="AlwaysOnAcrylicElementBrush"
                          FallbackColor="{StaticResource SystemChromeMediumColor}"
                          TintColor="{ThemeResource SystemChromeAltHighColor}"
                          TintOpacity="0.8"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="TrackListViewItemForeground" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="TrackListViewItemForegroundSelected" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="TrackListViewItemBorderBrush" ResourceKey="PageHeaderBorderBrush"/>
            <StaticResource x:Key="TrackListViewItemBackground" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="TrackListViewItemBackgroundSelected" ResourceKey="ControlSolidFillColorDefaultBrush"/>
            <StaticResource x:Key="TrackListViewItemAlternateBorderBrush" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TrackListViewItemAlternateBackground" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TopNavigationViewItemForeground" ResourceKey="TextFillColorSecondaryBrush"/>
            <Color x:Key="ShadowColor">#23000000</Color>
            <SolidColorBrush x:Key="RoundButtonStroke" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
            <SolidColorBrush x:Key="RoundButtonStrokePressed" Color="{ThemeResource ControlStrongStrokeColorDisabled}"/>
            <SolidColorBrush x:Key="RoundButtonStrokePointerOver" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
            <StaticResource x:Key="RoundButtonForegroundPressed" ResourceKey="ButtonForegroundPressed"/>
            <SolidColorBrush x:Key="RoundButtonFill"
                             Opacity="0.79"
                             Color="{ThemeResource SolidBackgroundFillColorSecondary}"/>
            <SolidColorBrush x:Key="RoundButtonFillPressed"
                             Opacity="0.79"
                             Color="{ThemeResource SolidBackgroundFillColorQuarternary}"/>
            <SolidColorBrush x:Key="RoundButtonFillPointerOver"
                             Opacity="0.79"
                             Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>
            <Thickness x:Key="PageHeaderBorderThickness">1</Thickness>
            <StaticResource x:Key="PageHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="PageHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="NowPlayingTrackForeground" ResourceKey="AccentTextFillColorPrimaryBrush"/>
            <StaticResource x:Key="NowPlayingTrackForegroundHighlighted" ResourceKey="AccentTextFillColorPrimaryBrush"/>
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#FFE5E5E5"/>
            <Thickness x:Key="MediaTransportControlsTitleSafeBounds">0</Thickness>
            <Thickness x:Key="MTCBorderThickness">0,1,0,0</Thickness>
            <StaticResource x:Key="MTCBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="MTCBackgroundBrush" ResourceKey="ControlOnImageFillColorDefaultBrush"/>
            <StaticResource x:Key="ListViewItemHyperlinkButtonForegroundThemeBrush" ResourceKey="ButtonForegroundThemeBrush"/>
            <StaticResource x:Key="ListViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridListViewItemBorderBrush" ResourceKey="PageHeaderBorderBrush"/>
            <Thickness x:Key="CovertArtBorderThickness">1</Thickness>
            <StaticResource x:Key="CoverArtForegroundBrush" ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBorderBrush" ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
            <Thickness x:Key="ContentDialogTitleMargin">24,24,24,12</Thickness>
            <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="SmokeFillColorDefaultBrush"/>
            <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
            <Thickness x:Key="ContentDialogContentScrollViewerPadding">24,0</Thickness>
            <Thickness x:Key="ContentDialogContentPadding">0,0,0,24</Thickness>
            <Thickness x:Key="CommandBarBorderThicknessOpen">0</Thickness>
            <StaticResource x:Key="CommandBarBorderBrushOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <AcrylicBrush x:Key="AlwaysOnAcrylicElementBrush"
                          FallbackColor="{StaticResource SystemChromeMediumColor}"
                          TintColor="{ThemeResource SystemChromeAltHighColor}"
                          TintOpacity="0.8"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="TrackListViewItemForeground" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="TrackListViewItemForegroundSelected" ResourceKey="ListViewItemForegroundSelected"/>
            <StaticResource x:Key="TrackListViewItemBorderBrush" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TrackListViewItemBackground" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="TrackListViewItemBackgroundSelected" ResourceKey="ListViewItemBackgroundSelected"/>
            <StaticResource x:Key="TrackListViewItemAlternateBorderBrush" ResourceKey="TrackListViewItemBorderBrush"/>
            <StaticResource x:Key="TrackListViewItemAlternateBackground" ResourceKey="TrackListViewItemBackground"/>
            <Color x:Key="ShadowColor">#00000000</Color>
            <StaticResource x:Key="RoundButtonStroke" ResourceKey="SystemColorButtonTextColorBrush"/>
            <StaticResource x:Key="RoundButtonStrokePressed" ResourceKey="SystemControlHighlightBaseHighBrush"/>
            <StaticResource x:Key="RoundButtonStrokePointerOver" ResourceKey="SystemControlHighlightBaseHighBrush"/>
            <StaticResource x:Key="RoundButtonForegroundPressed" ResourceKey="SystemControlHighlightAltAccentBrush"/>
            <StaticResource x:Key="RoundButtonFill" ResourceKey="SystemColorButtonFaceColorBrush"/>
            <StaticResource x:Key="RoundButtonFillPressed" ResourceKey="SystemControlHighlightBaseHighBrush"/>
            <StaticResource x:Key="RoundButtonFillPointerOver" ResourceKey="SystemColorHighlightTextColorBrush"/>
            <Thickness x:Key="PageHeaderBorderThickness">1</Thickness>
            <StaticResource x:Key="PageHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="PageHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="NowPlayingTrackForeground" ResourceKey="DefaultTextForegroundThemeBrush"/>
            <StaticResource x:Key="NowPlayingTrackForegroundHighlighted" ResourceKey="ListViewItemForegroundSelected"/>
            <Thickness x:Key="MediaTransportControlsTitleSafeBounds">0</Thickness>
            <Thickness x:Key="MTCBorderThickness">0,1,0,0</Thickness>
            <StaticResource x:Key="MTCBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
            <StaticResource x:Key="MTCBackgroundBrush" ResourceKey="ControlOnImageFillColorDefaultBrush"/>
            <StaticResource x:Key="ListViewItemHyperlinkButtonForegroundThemeBrush" ResourceKey="HyperlinkButtonForeground"/>
            <StaticResource x:Key="ListViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridViewHeaderItemDividerStroke" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="GridListViewItemBorderBrush" ResourceKey="ControlFillColorTransparentBrush"/>
            <Thickness x:Key="CovertArtBorderThickness">1</Thickness>
            <StaticResource x:Key="CoverArtForegroundBrush" ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBorderBrush" ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="CoverArtBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
            <Thickness x:Key="ContentDialogTitleMargin">24,24,24,12</Thickness>
            <SolidColorBrush x:Key="ContentDialogSmokeFill"
                             Opacity="0.8"
                             Color="{ThemeResource SystemColorWindowColor}"/>
            <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
            <Thickness x:Key="ContentDialogContentScrollViewerPadding">24,0</Thickness>
            <Thickness x:Key="ContentDialogContentPadding">0,0,0,24</Thickness>
            <Thickness x:Key="CommandBarBorderThicknessOpen">0</Thickness>
            <StaticResource x:Key="CommandBarBorderBrushOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>
            <SolidColorBrush x:Key="AlwaysOnAcrylicElementBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="UntamedFontFamily">ms-appx:///Assets/Fonts/UntamedFluentIcons.ttf#Untamed Fluent Icons</FontFamily>

    <x:Int32 x:Key="vkOemPlusKeyCode">187</x:Int32>
    <x:Int32 x:Key="vkOemMinusKeyCode">189</x:Int32>
    <x:Int32 x:Key="vkGoHome">172</x:Int32>
    <x:Int32 x:Key="vkGoBack">166</x:Int32>
    <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>

    <ws:VirtualKey x:Key="toggleMiniPlayerModeAcceleratorKey">M</ws:VirtualKey>
    <ws:VirtualKey x:Key="toggleFullScreenModeAcceleratorKey">F11</ws:VirtualKey>
    <ws:VirtualKey x:Key="shufflePlaybackAcceleratorKey">H</ws:VirtualKey>
    <ws:VirtualKey x:Key="repeatTrackAcceleratorKey">T</ws:VirtualKey>
    <ws:VirtualKey x:Key="openVideoLibraryAcceleratorKey">D</ws:VirtualKey>
    <ws:VirtualKey x:Key="openUrlAcceleratorKey">U</ws:VirtualKey>
    <ws:VirtualKey x:Key="openSettingsAcceleratorKey">G</ws:VirtualKey>
    <ws:VirtualKey x:Key="openSearchAcceleratorKey">E</ws:VirtualKey>
    <ws:VirtualKey x:Key="openPlaylistLibraryAcceleratorKey">Y</ws:VirtualKey>
    <ws:VirtualKey x:Key="openPlayQueueAcceleratorKey">Q</ws:VirtualKey>
    <ws:VirtualKey x:Key="openNowPlayingAcceleratorKey">N</ws:VirtualKey>
    <ws:VirtualKey x:Key="openMusicLibraryAcceleratorKey">R</ws:VirtualKey>
    <ws:VirtualKey x:Key="openHomePageAcceleratorKey">F</ws:VirtualKey>
    <ws:VirtualKey x:Key="openFileAcceleratorKey">O</ws:VirtualKey>
    <ws:VirtualKey x:Key="addUrlAcceleratorKey">U</ws:VirtualKey>
    <ws:VirtualKey x:Key="addFolderAcceleratorKey">D</ws:VirtualKey>
    <ws:VirtualKey x:Key="addFileAcceleratorKey">I</ws:VirtualKey>
    <ws:VirtualKeyModifiers x:Key="acceleratorModifierKey">Control</ws:VirtualKeyModifiers>
    <ws:VirtualKeyModifiers x:Key="secondaryAcceleratorModifierKey">Control,Shift</ws:VirtualKeyModifiers>

    <compat:PlaybackRate x:Key="PlaybackRateVerySlow" Value="VerySlow"/>
    <compat:PlaybackRate x:Key="PlaybackRateVeryFast" Value="VeryFast"/>
    <compat:PlaybackRate x:Key="PlaybackRateSlow" Value="Slow"/>
    <compat:PlaybackRate x:Key="PlaybackRateFast" Value="Fast"/>
    <compat:PlaybackRate x:Key="PlaybackRateDefault" Value="Default"/>
    <compat:PlaylistsDropCommandAdapter x:Key="playlistsDropCommandAdapter"/>

    <converters:SortAndFilterConverter x:Key="SortAndFilterConverter"/>
    <converters:EmptyObjectToVisibilityConverter x:Key="EmptyObjectToVisibilityConverter"/>
    <converters:DragItemsCountConverter x:Key="DragItemsCountConverter"/>
    <converters:EnumerationValueConverter x:Key="EnumerationValueToBoolConverter">
        <converters:EnumerationValueConverter.TrueValue>
            <x:Boolean>True</x:Boolean>
        </converters:EnumerationValueConverter.TrueValue>
        <converters:EnumerationValueConverter.FalseValue>
            <x:Boolean>False</x:Boolean>
        </converters:EnumerationValueConverter.FalseValue>
    </converters:EnumerationValueConverter>

    <compat:DragAndDropUIOverride x:Key="DragAndDropReject"
                                  x:Uid="DragAndDropReject"
                                  IsCaptionVisible="True"
                                  IsContentVisible="True"
                                  IsGlyphVisible="True"/>
    <compat:DragAndDropUIOverride x:Key="DragAndDropRejectOnPlaylists"
                                  x:Uid="DragAndDropRejectOnPlaylists"
                                  IsCaptionVisible="True"
                                  IsContentVisible="True"
                                  IsGlyphVisible="True"/>
    <compat:DragAndDropUIOverride x:Key="DragAndDropAcceptOnPlaylists"
                                  x:Uid="DragAndDropAcceptOnPlaylists"
                                  IsCaptionVisible="True"
                                  IsContentVisible="True"
                                  IsGlyphVisible="False"/>
    <compat:DragAndDropUIOverride x:Key="DragAndDropAcceptInPlayQueue"
                                  x:Uid="DragAndDropAcceptInPlayQueue"
                                  IsCaptionVisible="True"
                                  IsContentVisible="True"
                                  IsGlyphVisible="False"/>
    <compat:DragAndDropUIOverride x:Key="DragAndDropAcceptInPlayPage"
                                  x:Uid="DragAndDropAcceptInPlayPage"
                                  IsCaptionVisible="True"
                                  IsContentVisible="True"
                                  IsGlyphVisible="False"/>
</ResourceDictionary>
