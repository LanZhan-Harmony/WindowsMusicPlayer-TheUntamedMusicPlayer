<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:UntamedMediaPlayer.Controls">
    <Style x:Key="DefaultTextContainerStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DefaultMetadataControlStyle" TargetType="ctrl:MetadataControl">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:MetadataControl">
                    <TextBlock x:Name="TextContainer"
                               AutomationProperties.AccessibilityView="{TemplateBinding AccessibilityView}"
                               Style="{TemplateBinding TextBlockStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextBlockStyle" Value="{StaticResource DefaultTextContainerStyle}"/>
    </Style>
    <Style BasedOn="{StaticResource DefaultMetadataControlStyle}" TargetType="ctrl:MetadataControl"/>
</ResourceDictionary>
