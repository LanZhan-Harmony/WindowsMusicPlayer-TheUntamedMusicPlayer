                                        <Setter Target="ControlPanel_ControlPanelVisibilityStates_Border.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ControlPanelFadeOut">
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanel_ControlPanelVisibilityStates_Border.Opacity" Value="0"/>
                                        <Setter Target="ControlPanel_ControlPanelVisibilityStates_Border.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="ControlPanelFadeOut" To="ControlPanelFadeIn">
                                        <VisualTransition.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ControlPanel_ControlPanelVisibilityStates_Border"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0"
                                                                 To="1"
                                                                 Duration="{StaticResource ShortAnimationDuration}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ControlPanel_ControlPanelVisibilityStates_Border" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="TitleBarTranslateVertical"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="{StaticResource TopAnimationTranslationOffset}"
                                                                 To="0"
                                                                 Duration="{StaticResource ShortAnimationDuration}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TranslateVertical"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="{StaticResource BottomAnimationTranslationOffset}"
                                                                 To="0"
                                                                 Duration="{StaticResource ShortAnimationDuration}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="ControlPanelFadeIn" To="ControlPanelFadeOut">
                                        <VisualTransition.Storyboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ControlPanel_ControlPanelVisibilityStates_Border"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="1"
                                                                 To="0"
                                                                 Duration="{StaticResource AnimationDuration}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ControlPanel_ControlPanelVisibilityStates_Border" Storyboard.TargetProperty="IsHitTestVisible">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="False"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="TitleBarTranslateVertical"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0"
                                                                 To="{StaticResource TopAnimationTranslationOffset}"
                                                                 Duration="{StaticResource AnimationDuration}">
                                                    <DoubleAnimation.EasingFunction>
