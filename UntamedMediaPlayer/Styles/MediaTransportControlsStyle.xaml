                                                                           KeyTipPlacementMode="Left">
                                                            <MenuFlyoutSubItem.Icon>
                                                                <FontIcon Glyph="{StaticResource MTCPlaybackRateGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutSubItem.Items>
                                                                <ctrl:MenuFlyoutSelectableItem x:Name="MTCPlaybackRateButtonVerySlow"
                                                                                               x:Uid="MTCPlaybackRateButtonVerySlow"
                                                                                               AccessKey="G"
                                                                                               Command="{Binding MediaPlayerViewModel.ChangePlaybackRateCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                               CommandParameter="{StaticResource PlaybackRateVerySlow}"
                                                                                               KeyTipPlacementMode="Left">
                                                                    <ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="G" Modifiers="Control,Shift"/>
                                                                    </ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                </ctrl:MenuFlyoutSelectableItem>
                                                                <ctrl:MenuFlyoutSelectableItem x:Name="MTCPlaybackRateButtonSlow"
                                                                                               x:Uid="MTCPlaybackRateButtonSlow"
                                                                                               AccessKey="H"
                                                                                               Command="{Binding MediaPlayerViewModel.ChangePlaybackRateCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                               CommandParameter="{StaticResource PlaybackRateSlow}"
                                                                                               KeyTipPlacementMode="Left">
                                                                    <ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="H" Modifiers="Control,Shift"/>
                                                                    </ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                </ctrl:MenuFlyoutSelectableItem>
                                                                <ctrl:MenuFlyoutSelectableItem x:Name="MTCPlaybackRateButtonDefault"
                                                                                               x:Uid="MTCPlaybackRateButtonDefault"
                                                                                               AccessKey="J"
                                                                                               Command="{Binding MediaPlayerViewModel.ChangePlaybackRateCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                               CommandParameter="{StaticResource PlaybackRateDefault}"
                                                                                               KeyTipPlacementMode="Left">
                                                                    <ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="J" Modifiers="Control,Shift"/>
                                                                    </ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                </ctrl:MenuFlyoutSelectableItem>
                                                                <ctrl:MenuFlyoutSelectableItem x:Name="MTCPlaybackRateButtonFast"
                                                                                               x:Uid="MTCPlaybackRateButtonFast"
                                                                                               AccessKey="K"
                                                                                               Command="{Binding MediaPlayerViewModel.ChangePlaybackRateCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                               CommandParameter="{StaticResource PlaybackRateFast}"
                                                                                               KeyTipPlacementMode="Left">
                                                                    <ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="K" Modifiers="Control,Shift"/>
                                                                    </ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                </ctrl:MenuFlyoutSelectableItem>
                                                                <ctrl:MenuFlyoutSelectableItem x:Name="MTCPlaybackRateButtonVeryFast"
                                                                                               x:Uid="MTCPlaybackRateButtonVeryFast"
                                                                                               AccessKey="L"
                                                                                               Command="{Binding MediaPlayerViewModel.ChangePlaybackRateCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                               CommandParameter="{StaticResource PlaybackRateVeryFast}"
                                                                                               KeyTipPlacementMode="Left">
                                                                    <ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="L" Modifiers="Control,Shift"/>
                                                                    </ctrl:MenuFlyoutSelectableItem.KeyboardAccelerators>
                                                                </ctrl:MenuFlyoutSelectableItem>
                                                            </MenuFlyoutSubItem.Items>
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutItem x:Name="MTCCastToButton"
                                                                        x:Uid="MTCCastToButton"
                                                                        AccessKey="C"
                                                                        KeyTipPlacementMode="Left">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon x:Name="MTCCastToButtonIcon"
                                                                          Glyph="{StaticResource MTCCastToGlyph}"
                                                                          Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator Key="K" Modifiers="Control"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSubItem x:Uid="MTCVideoSettings"
                                                                           AccessKey="V"
                                                                           IsAccessKeyScope="True"
                                                                           IsEnabled="{Binding MediaPlayerViewModel.IsPlayingVideo, RelativeSource={RelativeSource TemplatedParent}}"
                                                                           KeyTipPlacementMode="Left">
                                                            <MenuFlyoutSubItem.Icon>
                                                                <FontIcon Glyph="{StaticResource VideoSettingsGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutSubItem.Items>
                                                                <MenuFlyoutItem x:Uid="MTCRotateVideo"
                                                                                AccessKey="R"
                                                                                Command="{Binding MediaPlayerViewModel.RotateMediaCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                KeyTipPlacementMode="Left">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="{StaticResource RotateVideoGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                                    </MenuFlyoutItem.Icon>
                                                                    <MenuFlyoutItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="R" Modifiers="Control,Shift"/>
                                                                    </MenuFlyoutItem.KeyboardAccelerators>
                                                                </MenuFlyoutItem>
                                                                <ToggleMenuFlyoutItem x:Uid="MTCZoomToFillButton"
                                                                                      AccessKey="Z"
                                                                                      Command="{Binding MediaPlayerViewModel.ToggleZoomToFillCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                      IsChecked="{Binding MediaPlayerViewModel.IsZoomedToFill, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                      KeyTipPlacementMode="Left">
                                                                    <ToggleMenuFlyoutItem.Icon>
                                                                        <FontIcon x:Name="MTCZoomToFillButtonIcon"
                                                                                  Glyph="{StaticResource MTCZoomToFillGlyph}"
                                                                                  Style="{StaticResource MediaFontIcon}"/>
                                                                    </ToggleMenuFlyoutItem.Icon>
                                                                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift"/>
                                                                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                                                                </ToggleMenuFlyoutItem>
                                                                <MenuFlyoutItem x:Name="videoEnhancerItem"
                                                                                x:Uid="MTCVideoEnhancer"
                                                                                AccessKey="E"
                                                                                KeyTipPlacementMode="Left">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="{StaticResource VideoEnhancerGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                                    </MenuFlyoutItem.Icon>
                                                                    <MenuFlyoutItem.KeyboardAccelerators>
                                                                        <KeyboardAccelerator Key="V" Modifiers="Control,Shift"/>
                                                                    </MenuFlyoutItem.KeyboardAccelerators>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyoutSubItem.Items>
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutItem x:Name="MTCOverflowSkipBackwardButton"
                                                                        x:Uid="MTCOverflowSkipBackwardButton"
                                                                        AccessKey="I"
                                                                        Command="{Binding MediaPlayerViewModel.SkipBackwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Visibility="Visible">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{StaticResource MTCSkipBackwardGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator x:Name="MTCOverflowSkipBackwardButtonAccelerator"
                                                                                     Key="Left"
                                                                                     Modifiers="Control"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="MTCOverflowSkipForwardButton"
                                                                        x:Uid="MTCOverflowSkipForwardButton"
                                                                        AccessKey="O"
                                                                        Command="{Binding MediaPlayerViewModel.SkipForwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Visibility="Visible">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{StaticResource MTCSkipForwardGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator x:Name="MTCOverflowSkipForwardButtonAccelerator"
                                                                                     Key="Right"
                                                                                     Modifiers="Control"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="OverflowShuffleButton"
                                                                        AccessKey="H"
                                                                        Command="{Binding MediaPlayerViewModel.ToggleShuffleModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Text="{Binding MediaPlayerViewModel.ToggleShuffleModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon x:Name="OverflowShuffleButtonIcon"
                                                                          Glyph="{StaticResource MTCShuffleOffCommandGlyph}"
                                                                          Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator x:Name="MTCOverflowShuffleKeyboardAccelerator"
                                                                                     Key="{StaticResource shufflePlaybackAcceleratorKey}"
                                                                                     IsEnabled="False"
                                                                                     Modifiers="{StaticResource acceleratorModifierKey}"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="OverflowRepeatButton"
                                                                        AccessKey="T"
                                                                        Command="{Binding MediaPlayerViewModel.ToggleRepeatModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Text="{Binding MediaPlayerViewModel.ToggleRepeatModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon x:Name="OverflowRepeatButtonIcon"
                                                                          Glyph="{StaticResource MTCRepeatOffGlyph}"
                                                                          Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator x:Name="MTCOverflowRepeatKeyboardAccelerator"
                                                                                     Key="{StaticResource repeatTrackAcceleratorKey}"
                                                                                     IsEnabled="False"
                                                                                     Modifiers="{StaticResource acceleratorModifierKey}"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="MTCOverflowFullWindowButton"
                                                                        AccessKey="U"
                                                                        Command="{Binding MediaPlayerViewModel.ToggleFullScreenModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Text="{Binding MediaPlayerViewModel.ToggleFullScreenModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon x:Name="OverflowFullWindowGlyph"
                                                                          Glyph="{StaticResource MTCEnterFullScreenGlyph}"
                                                                          Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator x:Name="MTCOverflowFullWindowKeyboardAccelerator"
                                                                                     Key="{StaticResource toggleFullScreenModeAcceleratorKey}"
                                                                                     IsEnabled="False"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout.Items>
                                                </MenuFlyout>
                                            </AppBarButton.Flyout>
                                        </AppBarButton>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="NotificationPopupContainer"
                                              MinWidth="{StaticResource NotificationPopupMinWidth}"
                                              MaxWidth="{StaticResource NotificationPopupMaxWidth}"
                                              Margin="{StaticResource ContentBottomRightSpacing}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Content="{TemplateBinding Notifications}"/>
                            <Grid x:Name="TopControlPanelGrid"
                                  Margin="{TemplateBinding TitleBarMargin}"
                                  VerticalAlignment="Top">
                                <Border>
                                    <ContentPresenter Content="{TemplateBinding FullWindowTitleBar}"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
</ResourceDictionary>
