                                        <Setter Target="ControlPanelGrid.(Grid.Row)" Value="0"/>
                                        <Setter Target="ControlPanelGrid.BorderThickness" Value="0"/>
                                        <Setter Target="RowDefinition_Top.Height" Value="*"/>
                                        <Setter Target="RowDefinition_Middle.Height" Value="Auto"/>
                                        <Setter Target="RowDefinition_Bottom.Height" Value="Auto"/>
                                        <Setter Target="MediaControlsCommandBar_Left.(Grid.Row)" Value="0"/>
                                        <Setter Target="MediaControlsCommandBar_Left.(Grid.RowSpan)" Value="3"/>
                                        <Setter Target="MediaControlsCommandBar_Left.VerticalAlignment" Value="Bottom"/>
                                        <Setter Target="MediaControlsCommandBar_Left.Visibility" Value="Collapsed"/>
                                        <Setter Target="MediaControlsCommandBar_Left.Opacity" Value="0"/>
                                        <Setter Target="MediaControlsCommandBar_Center.(Grid.Row)" Value="0"/>
                                        <Setter Target="MediaControlsCommandBar_Center.(Grid.RowSpan)" Value="2"/>
                                        <Setter Target="MediaControlsCommandBar_Center.(Grid.Column)" Value="0"/>
                                        <Setter Target="MediaControlsCommandBar_Center.(Grid.ColumnSpan)" Value="3"/>
                                        <Setter Target="MediaControlsCommandBar_Center.VerticalAlignment" Value="Center"/>
                                        <Setter Target="MediaControlsCommandBar_Right.(Grid.Row)" Value="1"/>
                                        <Setter Target="MediaTransportControls_Timeline_Border.(Grid.Row)" Value="2"/>
                                        <Setter Target="MediaTransportControls_Timeline_Grid.Margin" Value="0"/>
                                        <Setter Target="ProgressSlider.Visibility" Value="Collapsed"/>
                                        <Setter Target="MiniProgressBar.Visibility" Value="Visible"/>
                                        <Setter Target="ControlPanelGrid.RenderTransform" Value="{x:Null}"/>
                                        <Setter Target="TitleBarBackground.RenderTransform" Value="{x:Null}"/>
                                        <Setter Target="TitleBarBackground.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="FullscreenLayout">
                                    <VisualState.StateTriggers>
                                        <helpers:ViewportStateTrigger State="FullScreen"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Padding" Value="{StaticResource MTCFullScreenOffsetForTasksbar}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PlaybackRateOptionsGroup">
                                <VisualState x:Name="PlaybackrateVerySlowState">
                                    <VisualState.Setters>
                                        <Setter Target="MTCPlaybackRateButtonVerySlow.IsChecked" Value="True"/>
                                        <Setter Target="MTCPlaybackRateButtonSlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonDefault.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonFast.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonVeryFast.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PlaybackrateSlowState">
                                    <VisualState.Setters>
                                        <Setter Target="MTCPlaybackRateButtonVerySlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonSlow.IsChecked" Value="True"/>
                                        <Setter Target="MTCPlaybackRateButtonDefault.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonFast.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonVeryFast.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PlaybackrateDefaultState">
                                    <VisualState.Setters>
                                        <Setter Target="MTCPlaybackRateButtonVerySlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonSlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonDefault.IsChecked" Value="True"/>
                                        <Setter Target="MTCPlaybackRateButtonFast.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonVeryFast.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PlaybackrateFastState">
                                    <VisualState.Setters>
                                        <Setter Target="MTCPlaybackRateButtonVerySlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonSlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonDefault.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonFast.IsChecked" Value="True"/>
                                        <Setter Target="MTCPlaybackRateButtonVeryFast.IsChecked" Value="False"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PlaybackrateVeryFastState">
                                    <VisualState.Setters>
                                        <Setter Target="MTCPlaybackRateButtonVerySlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonSlow.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonDefault.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonFast.IsChecked" Value="False"/>
                                        <Setter Target="MTCPlaybackRateButtonVeryFast.IsChecked" Value="True"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentDisplayModeGroup">
                                <VisualState x:Name="ContentHiddenState"/>
                                <VisualState x:Name="ContentInlineState">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding DisplayMode, Converter={StaticResource EnumerationValueToBoolConverter}, ConverterParameter={StaticResource InlineDisplayMode}}"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ContentContainer.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PlaybackModeGroup">
                                <VisualState x:Name="PlaybackModeInactive"/>
                                <VisualState x:Name="PlaybackModeActive">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsInPlaybackMode, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Background" Value="{ThemeResource MTCBackgroundBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="LiveStreamGroup">
                                <VisualState x:Name="NotLiveStream"/>
                                <VisualState x:Name="LiveStream">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsLiveStream, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="LiveStreamIconElement.Visibility" Value="Visible"/>
                                        <Setter Target="TimeRemainingElement.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="ControlPanel_ControlPanelVisibilityStates_Border">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TitleBarBackground"
                                    Height="{TemplateBinding SystemTitleBarHeight}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource MTCBackgroundBrush}"
                                    Visibility="{Binding IsTitleBarBackgroundVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TitleBarTranslateVertical"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="ContentContainerHost">
                                <Border.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="AppBarButtonForeground" ResourceKey="ButtonForeground"/>
                                                <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="ButtonForegroundPressed"/>
                                                <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="ButtonForegroundPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="ButtonForegroundDisabled"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="ButtonBorderBrush"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="ButtonBorderBrushPressed"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="ButtonBorderBrushDisabled"/>
                                                <StaticResource x:Key="AppBarButtonBackground" ResourceKey="ButtonBackground"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="ButtonBackgroundPressed"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="ButtonBackgroundDisabled"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="AppBarButtonForeground" ResourceKey="ButtonForeground"/>
                                                <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="ButtonForegroundPressed"/>
                                                <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="ButtonForegroundPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="ButtonForegroundDisabled"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="ButtonBorderBrush"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="ButtonBorderBrushPressed"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="ButtonBorderBrushDisabled"/>
                                                <StaticResource x:Key="AppBarButtonBackground" ResourceKey="ButtonBackground"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="ButtonBackgroundPressed"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver"/>
                                                <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="ButtonBackgroundDisabled"/>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Border.Resources>
                                <Border x:Name="ContentContainer" Visibility="Collapsed">
                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                    <animations:Implicit.ShowAnimations>
                                        <animations:OpacityAnimation From="0"
                                                                     To="1"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    </animations:Implicit.ShowAnimations>
                                    <animations:Implicit.HideAnimations>
                                        <animations:OpacityAnimation From="1"
                                                                     To="0"
                                                                     Duration="{StaticResource ShortAnimationDuration}"/>
                                    </animations:Implicit.HideAnimations>
                                </Border>
                            </Border>
                            <Grid x:Name="ControlPanelGrid"
                                  x:Uid="MediaTransportControls"
                                  Grid.Row="1"
                                  AutomationProperties.LandmarkType="Custom"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource MTCBorderBrush}"
                                  BorderThickness="{ThemeResource MTCBorderThickness}"
                                  FlowDirection="LeftToRight"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Dark">
                                                <x:Double x:Key="AppBarThemeCompactHeight">0</x:Double>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <x:Double x:Key="AppBarThemeCompactHeight">0</x:Double>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast">
                                                <x:Double x:Key="AppBarThemeCompactHeight">0</x:Double>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                        <Thickness x:Key="AppBarButtonContentViewboxCompactMargin">0,16</Thickness>
                                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0</Thickness>
                                    </ResourceDictionary>
                                </Grid.Resources>
                                <Grid.BackgroundTransition>
                                    <BrushTransition/>
                                </Grid.BackgroundTransition>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="TranslateVertical"/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition_Left" Width="*"/>
                                    <ColumnDefinition x:Name="ColumnDefinition_Center" Width="Auto"/>
                                    <ColumnDefinition x:Name="ColumnDefinition_Right" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition_Top" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinition_Middle" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinition_Bottom" Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ErrorBorder"
                                        Grid.ColumnSpan="3"
                                        Width="320"
                                        Height="96"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ErrorTextBlock"
                                               Margin="12"
                                               Style="{StaticResource MediaTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                </Border>
                                <Border x:Name="MediaTransportControls_Timeline_Border"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                    <Grid x:Name="MediaTransportControls_Timeline_Grid" Margin="{StaticResource ContentSideMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="TimeElapsedElementSpacer"
                                                   AutomationProperties.AccessibilityView="Raw"
                                                   Opacity="0"
                                                   Style="{StaticResource MediaTextBlockStyle}"
                                                   Text="00.00:00"/>
                                        <ctrl:DurationTextBlock x:Name="TimeElapsedElement"
                                                                VerticalAlignment="Center"
                                                                Content="00:00"
                                                                IsRemainingDuration="False"
                                                                TextStyle="{StaticResource MediaTextBlockStyle}"
                                                                ViewModel="{TemplateBinding MediaPlayerViewModel}"/>
                                        <ctrl:DurationSlider x:Name="ProgressSlider"
                                                             Grid.Column="1"
                                                             MinWidth="80"
                                                             Margin="{StaticResource ContentSideMargin}"
                                                             VerticalAlignment="Center"
                                                             AccessKey="S"
                                                             IsThumbToolTipEnabled="False"
                                                             KeyTipPlacementMode="Top"
                                                             Style="{StaticResource DefaultSliderStyle}"
                                                             Duration="{Binding MediaPlayerViewModel.Duration, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <ProgressBar x:Name="MiniProgressBar"
                                                     Grid.Column="1"
                                                     Maximum="{Binding ElementName=ProgressSlider, Path=Maximum}"
                                                     Minimum="{Binding ElementName=ProgressSlider, Path=Minimum}"
                                                     Visibility="Collapsed"
                                                     Value="{Binding ElementName=ProgressSlider, Path=Value}"/>
                                        <ProgressBar x:Name="BufferingProgressBar"
                                                     Grid.Column="1"
                                                     Height="4"
                                                     Margin="{StaticResource ContentSideMargin}"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.AccessibilityView="Raw"
                                                     IsHitTestVisible="False"
                                                     IsIndeterminate="True"
                                                     ShowPaused="True"
                                                     Visibility="Collapsed"/>
                                        <Grid x:Name="TimeRemainingContainer" Grid.Column="2">
                                            <TextBlock HorizontalAlignment="Right"
                                                       AutomationProperties.AccessibilityView="Raw"
                                                       Opacity="0"
                                                       Style="{StaticResource MediaTextBlockStyle}"
                                                       Text="00.00:00"/>
                                            <ctrl:DurationTextBlock x:Name="TimeRemainingElement"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Content="00:00"
                                                                    IsRemainingDuration="True"
                                                                    TextStyle="{StaticResource MediaTextBlockStyle}"
                                                                    ViewModel="{TemplateBinding MediaPlayerViewModel}"/>
                                            <FontIcon x:Name="LiveStreamIconElement"
                                                      HorizontalAlignment="center"
                                                      FontSize="{ThemeResource MTCMediaFontSize}"
                                                      Glyph="{StaticResource LiveStreamGlyph}"
                                                      Style="{StaticResource CommandFontIcon}"
                                                      Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="LeftSidePlayBorder"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Visibility="Collapsed">
                                    <AppBarButton x:Name="PlayPauseButtonOnLeft"
                                                  Margin="0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AppBarButtonStyle}">
                                        <AppBarButton.Icon>
                                            <FontIcon x:Name="PlayPauseGlyphLeft"
                                                      Glyph="{StaticResource MTCPlayGlyph}"
                                                      Style="{StaticResource CommandFontIcon}"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                </Border>
                                <Border x:Name="MediaControlsCommandBar_Left"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Height="{StaticResource MTCCommandPanelHeaderHeight}"
                                        Margin="{StaticResource ElementSmallLeftButtomMargin}">
                                    <ContentPresenter Content="{TemplateBinding CommandPanelHeader}"/>
                                </Border>
                                <Border x:Name="MediaControlsCommandBar_Center"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center">
                                    <StackPanel x:Name="MediaControlsCommandBar_Center_Container" Style="{StaticResource MediaControlCommandBarContainer}">
                                        <AppBarButton x:Name="StopButton"
                                                      Icon="Stop"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed"/>
                                        <AppBarButton x:Name="ShuffleButton"
                                                      AccessKey="H"
                                                      Command="{Binding MediaPlayerViewModel.ToggleShuffleModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Label="{Binding MediaPlayerViewModel.ToggleShuffleModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="ShuffleButtonIcon"
                                                          Glyph="{StaticResource MTCShuffleOffCommandGlyph}"
                                                          Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator x:Name="MTCShuffleKeyboardAccelerator"
                                                                     Key="{StaticResource shufflePlaybackAcceleratorKey}"
                                                                     Modifiers="{StaticResource acceleratorModifierKey}"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <animations:Implicit.ShowAnimations>
                                                <animations:OpacityAnimation From="0"
                                                                             To="1"
                                                                             Duration="{StaticResource AnimationDuration}"/>
                                            </animations:Implicit.ShowAnimations>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCPreviousTrackButton"
                                                      x:Uid="MTCPreviousTrackButton"
                                                      AccessKey="B"
                                                      Command="{Binding MediaPlayerViewModel.MoveToPreviousTrackCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCPreviousTrackGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="B" Modifiers="Control"/>
                                            </AppBarButton.KeyboardAccelerators>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCSkipBackwardButton"
                                                      x:Uid="MTCSkipBackwardButton"
                                                      AccessKey="I"
                                                      Command="{Binding MediaPlayerViewModel.SkipBackwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCSkipBackwardGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator x:Name="MTCSkipBackwardButtonAccelerator"
                                                                     Key="Left"
                                                                     IsEnabled="False"
                                                                     Modifiers="Control"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <animations:Implicit.ShowAnimations>
                                                <animations:OpacityAnimation From="0"
                                                                             To="1"
                                                                             Duration="{StaticResource AnimationDuration}"/>
                                            </animations:Implicit.ShowAnimations>
                                        </AppBarButton>
                                        <AppBarButton x:Name="RewindButton"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCPlayPauseButton"
                                                      AccessKey="P"
                                                      Command="{Binding MediaPlayerViewModel.TogglePlayPauseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Label="{Binding MediaPlayerViewModel.TogglePlayPauseCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource PlayCommandAppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="PlayPauseGlyph"
                                                          Glyph="{StaticResource MTCPlayGlyph}"
                                                          Style="{StaticResource PlayCommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="P" Modifiers="Control"/>
                                                <KeyboardAccelerator Key="Space"/>
                                            </AppBarButton.KeyboardAccelerators>
                                        </AppBarButton>
                                        <AppBarButton x:Name="FastForwardButton"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCSkipForwardButton"
                                                      x:Uid="MTCSkipForwardButton"
                                                      AccessKey="O"
                                                      Command="{Binding MediaPlayerViewModel.SkipForwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCSkipForwardGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator x:Name="MTCSkipForwardButtonAccelerator"
                                                                     Key="Right"
                                                                     IsEnabled="False"
                                                                     Modifiers="Control"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <animations:Implicit.ShowAnimations>
                                                <animations:OpacityAnimation From="0"
                                                                             To="1"
                                                                             Duration="{StaticResource AnimationDuration}"/>
                                            </animations:Implicit.ShowAnimations>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCNextTrackButton"
                                                      x:Uid="MTCNextTrackButton"
                                                      AccessKey="F"
                                                      Command="{Binding MediaPlayerViewModel.MoveToNextTrackCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCNextTrackGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="F" Modifiers="Control"/>
                                            </AppBarButton.KeyboardAccelerators>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCRepeatButton"
                                                      AccessKey="T"
                                                      Command="{Binding MediaPlayerViewModel.ToggleRepeatModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Label="{Binding MediaPlayerViewModel.ToggleRepeatModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="RepeatButtonIcon"
                                                          Glyph="{StaticResource MTCRepeatOffGlyph}"
                                                          Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator x:Name="MTCRepeatKeyboardAccelerator"
                                                                     Key="{StaticResource repeatTrackAcceleratorKey}"
                                                                     Modifiers="{StaticResource acceleratorModifierKey}"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <animations:Implicit.ShowAnimations>
                                                <animations:OpacityAnimation From="0"
                                                                             To="1"
                                                                             Duration="{StaticResource AnimationDuration}"/>
                                            </animations:Implicit.ShowAnimations>
                                        </AppBarButton>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MediaControlsCommandBar_Right"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right">
                                    <StackPanel x:Name="MediaControlsCommandBar_Right_Container" Style="{StaticResource MediaControlCommandBarContainer}">
                                        <AppBarButton x:Name="CompactOverlayButton"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCEnterMiniPlayerGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCLanguageButton"
                                                      x:Uid="MTCLanguageButton"
                                                      AccessKey="L"
                                                      IsEnabled="{Binding MediaPlayerViewModel.IsPlayingVideo, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCLanguagesAndSubsGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator x:Name="MTCLanguageKeyboardAccelerator"
                                                                     Key="L"
                                                                     Modifiers="Control"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <i:Interaction.Behaviors>
                                                <behaviors:LanguageSelectionBehavior ViewModel="{Binding MediaPlayerViewModel.LanguageSelection, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </i:Interaction.Behaviors>
                                        </AppBarButton>
                                        <AppBarButton x:Name="VolumeMuteButton"
                                                      AccessKey="V"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="VolumeMuteGlyph"
                                                          Glyph="{StaticResource MTCVolumeGlyph}"
                                                          Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.Flyout>
                                                <Flyout x:Name="VolumeFlyout" FlyoutPresenterStyle="{StaticResource FlyoutStyle}">
                                                    <StackPanel IsAccessKeyScope="True"
                                                                KeyTipPlacementMode="Top"
                                                                Orientation="Horizontal">
                                                        <AppBarButton x:Name="AudioMuteButton"
                                                                      Margin="12"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      AccessKey="M"
                                                                      Style="{StaticResource AppBarButtonStyle}">
                                                            <AppBarButton.Resources>
                                                                <ResourceDictionary>
                                                                    <Thickness x:Key="AppBarButtonContentViewboxCompactMargin">0,16</Thickness>
                                                                    <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0</Thickness>
                                                                </ResourceDictionary>
                                                            </AppBarButton.Resources>
                                                            <AppBarButton.Icon>
                                                                <FontIcon x:Name="AudioMuteGlyph"
                                                                          Glyph="{StaticResource MTCVolumeGlyph}"
                                                                          Style="{StaticResource CommandFontIcon}"/>
                                                            </AppBarButton.Icon>
                                                            <AppBarButton.KeyboardAccelerators>
                                                                <KeyboardAccelerator Key="Number0" Modifiers="Control"/>
                                                                <KeyboardAccelerator Key="NumberPad0" Modifiers="Control"/>
                                                            </AppBarButton.KeyboardAccelerators>
                                                        </AppBarButton>
                                                        <Slider x:Name="VolumeSlider"
                                                                Width="{ThemeResource MTCHorizontalVolumeSliderWidth}"
                                                                Margin="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                AccessKey="V"
                                                                IsThumbToolTipEnabled="False"
                                                                Value="50"/>
                                                        <Grid Margin="12" VerticalAlignment="Center">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       AutomationProperties.AccessibilityView="Raw"
                                                                       Opacity="0"
                                                                       Style="{StaticResource MediaTextBlockStyle}"
                                                                       Text="100"/>
                                                            <TextBlock x:Name="VolumeValue"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MediaTextBlockStyle}"
                                                                       Text="{Binding ElementName=VolumeSlider, Path=Value}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Flyout>
                                            </AppBarButton.Flyout>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCFullWindowButton"
                                                      AccessKey="U"
                                                      Command="{Binding MediaPlayerViewModel.ToggleFullScreenModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Label="{Binding MediaPlayerViewModel.ToggleFullScreenModeCommand.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="FullWindowGlyph"
                                                          Glyph="{StaticResource MTCEnterFullScreenGlyph}"
                                                          Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="{StaticResource toggleFullScreenModeAcceleratorKey}" x:Name="MTCFullWindowKeyboardAccelerator"/>
                                            </AppBarButton.KeyboardAccelerators>
                                            <animations:Implicit.ShowAnimations>
                                                <animations:OpacityAnimation From="0"
                                                                             To="1"
                                                                             Duration="{StaticResource AnimationDuration}"/>
                                            </animations:Implicit.ShowAnimations>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MTCMiniPlayerButton"
                                                      AccessKey="M"
                                                      Command="{Binding MediaPlayerViewModel.ToggleMiniPlayerModeCommand, RelativeSource={RelativeSource TemplatedParent}}"
