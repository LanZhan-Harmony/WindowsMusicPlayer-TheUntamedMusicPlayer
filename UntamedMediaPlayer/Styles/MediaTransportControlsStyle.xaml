                                                      Style="{StaticResource AppBarButtonStyle}"
                                                      Visibility="Collapsed">
                                            <AppBarButton.Icon>
                                                <FontIcon x:Name="MiniPlayerIcon"
                                                          Glyph="{StaticResource MTCEnterMiniPlayerGlyph}"
                                                          Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="{StaticResource toggleMiniPlayerModeAcceleratorKey}" Modifiers="{StaticResource acceleratorModifierKey}"/>
                                            </AppBarButton.KeyboardAccelerators>
                                        </AppBarButton>
                                        <AppBarButton x:Name="OverFlowButton"
                                                      x:Uid="MTCOverFlowButton"
                                                      AccessKey="R"
                                                      Style="{StaticResource AppBarButtonStyle}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="{StaticResource MTCOverFlowButtonGlyph}" Style="{StaticResource CommandFontIcon}"/>
                                            </AppBarButton.Icon>
                                            <AppBarButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyout.Items>
                                                        <MenuFlyoutItem x:Uid="MTCViewFileInfo"
                                                                        AccessKey="P"
                                                                        Command="{Binding MediaPlayerViewModel.ShowFilePropertiesCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{StaticResource MTCViewFileInfoGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator Key="I" Modifiers="Control"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem x:Uid="MTCEditWithClipChamp"
                                                                        AccessKey="D"
                                                                        Command="{Binding MediaPlayerViewModel.EditWithClipChampCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left"
                                                                        Visibility="{Binding MediaPlayerViewModel.EditWithClipChampCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{StaticResource ClipChampGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator Visibility="{Binding MediaPlayerViewModel.EditWithClipChampCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                                                        <MenuFlyoutItem x:Uid="MTCShowEqualizer"
                                                                        AccessKey="E"
                                                                        Command="{Binding MediaPlayerViewModel.ShowEqualizerCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        KeyTipPlacementMode="Left">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{StaticResource MTCEqualizerGlyph}" Style="{StaticResource MediaFontIcon}"/>
                                                            </MenuFlyoutItem.Icon>
                                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                                <KeyboardAccelerator Key="E" Modifiers="Control,Shift"/>
                                                            </MenuFlyoutItem.KeyboardAccelerators>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSubItem x:Uid="MTCPlaybackRateButton"
                                                                           AccessKey="S"
