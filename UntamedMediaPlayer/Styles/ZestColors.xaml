                    <StaticResource x:Key="AccentGradientBackgroundHoverBrush" ResourceKey="ControlFillColorSecondaryBrush"/>
                    <StaticResource x:Key="AccentGradientBackgroundDisabledBrush" ResourceKey="ControlFillColorDisabledBrush"/>
                    <StaticResource x:Key="AccentGradientBackgroundBrush" ResourceKey="ControlFillColorDefaultBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ColorPaletteResources Accent="#FFD03F0A"/>
                <ResourceDictionary>
                    <Color x:Key="SystemAccentColorLight3">#FFD03F0A</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFD03F0A</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFD03F0A</Color>
                    <Color x:Key="SystemAccentColorDark3">#FFD03F0A</Color>
