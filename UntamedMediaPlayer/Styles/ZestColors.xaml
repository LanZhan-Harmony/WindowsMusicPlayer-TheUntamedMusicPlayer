                            <GradientStop Offset="0.4" Color="#FFED7525"/>
                            <GradientStop Offset="0.53" Color="#FFE15963"/>
                            <GradientStop Offset="0.66" Color="#FFCF427E"/>
                            <GradientStop Offset="0.79" Color="#FFB5318B"/>
                            <GradientStop Offset="0.92" Color="#FF962C8D"/>
                            <GradientStop Offset="1" Color="#FF712E85"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentGradientBrushHover" StartPoint="0,0.135" EndPoint="1,0.865">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.19" Color="#FFED7525"/>
                            <GradientStop Offset="0.3" Color="#FFE15963"/>
                            <GradientStop Offset="0.42" Color="#FFCF427E"/>
                            <GradientStop Offset="0.53" Color="#FFB5318B"/>
                            <GradientStop Offset="0.65" Color="#FF962C8D"/>
