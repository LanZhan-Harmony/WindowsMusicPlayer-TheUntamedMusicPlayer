                            <GradientStop Offset="0.3" Color="#FFE15963"/>
                            <GradientStop Offset="0.42" Color="#FFCF427E"/>
                            <GradientStop Offset="0.53" Color="#FFB5318B"/>
                            <GradientStop Offset="0.65" Color="#FF962C8D"/>
                            <GradientStop Offset="0.77" Color="#FF712E85"/>
                            <GradientStop Offset="0.89" Color="#FF483174"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AccentGradientBrushDisabled" Color="#0F000000"/>
                    <StaticResource x:Key="AccentGradientBackgroundPressedBrush" ResourceKey="ControlFillColorTertiaryBrush"/>
                    <StaticResource x:Key="AccentGradientBackgroundHoverBrush" ResourceKey="ControlFillColorSecondaryBrush"/>
                    <StaticResource x:Key="AccentGradientBackgroundDisabledBrush" ResourceKey="ControlFillColorDisabledBrush"/>
                    <StaticResource x:Key="AccentGradientBackgroundBrush" ResourceKey="ControlFillColorDefaultBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AccentGradientBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentGradientBrushPressed" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentGradientBrushHover" Color="{ThemeResource SystemAccentColor}"/>
            <StaticResource x:Key="AccentGradientBrushDisabled" ResourceKey="SystemControlDisabledBaseLowBrush"/>
            <StaticResource x:Key="AccentGradientBackgroundPressedBrush" ResourceKey="AppBarButtonBackgroundPressed"/>
            <StaticResource x:Key="AccentGradientBackgroundHoverBrush" ResourceKey="AppBarButtonBackgroundPointerOver"/>
            <StaticResource x:Key="AccentGradientBackgroundDisabledBrush" ResourceKey="AppBarButtonBackgroundDisabled"/>
            <StaticResource x:Key="AccentGradientBackgroundBrush" ResourceKey="AppBarButtonBackground"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
